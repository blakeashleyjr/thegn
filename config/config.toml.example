# thegn config — copy to ~/.config/thegn/config.toml and edit.
# All keys are optional (sane defaults apply). Home-manager users get this
# generated automatically from programs.thegn.

# ── Release channel ───────────────────────────────────────────────────────────
# thegn ships in two channels. The regular (stable) build runs the AI-free
# workspace shell — git/worktrees/panes/sidebar/panel, the command palette,
# sessions, sandboxing, and the CLI merge/land/integrate queue. Several
# subsystems are still experimental and are DISABLED in the stable build even if
# the keys below are set: remotes ([sandbox.remote]), the Observe dashboards
# ([observe]), the placement engine ([placement]), and the non-GitHub issue
# trackers ([issues]: Linear / Jira / Kaneo). GitHub PR/issue viewing stays available in both channels.
# To enable the experimental subsystems, run the dev build (`nix run .#dev`,
# installed as `thegn-dev`) or set THEGN_CHANNEL=dev for one run. `thegn doctor`
# prints the resolved channel and which features it allows. There is no config
# key for the channel — it is a property of the binary/env, not the config file.

# Where worktrees live (grouped per repo) and where remote URLs are cloned.
worktrees_dir = "~/.thegn/worktrees"
workspaces_dir = "~/code"

# Roots scanned by the workspace repo picker (new-workspace / bare `thegn`).
# Defaults to [workspaces_dir] if omitted.
repo_roots = ["~/code", "~/src"]
repo_scan_depth = 5

# Base ref for new worktrees: "auto" = current branch, else the repo default.
base_branch = "auto"
window_margin = 0
branch_prefix = "tg/"

# Picker UI: "auto" | "gum" | "fzf" | "select"
picker = "auto"

# Worktree location: "global" | "in_repo" (<repo>/.worktrees)
worktree_mode = "global"

# Auto branch naming: "words" (sz/brisk-otter) | "numbered" (sz/pane-1)
name_scheme = "words"

# Remove the worktree automatically when its pane closes.
auto_remove_worktree = false
# Ask before destructive worktree actions (sidebar delete-from-disk).
confirm_delete = true

# ── Overriding any setting at runtime ─────────────────────────────────────────
# Precedence (low → high): built-in defaults < this file < THEGN_* env vars
#   < CLI flags. Override any key for one run with THEGN_<SECTION>_<KEY>, e.g.
#     THEGN_PICKER=fzf        THEGN_SANDBOX_BACKEND=docker
#     THEGN_LOG_LEVEL=debug   THEGN_PR_TTL=10
# `thegn config show` prints the effective merged config; `thegn config
# get <dotted.key>` prints one value; `thegn config validate` checks it.

[ui]
# UI language: a BCP-47 code (e.g. "en-US", "ja-JP") or "auto" to detect.
language = "auto"
# Ask before removing a workspace (Alt+Shift+X, or the sidebar "Remove
# workspace" action — both share one modal). The modal pre-selects the safe
# "remove from thegn — keep all files"; deleting the branch worktree dirs
# from disk is the explicit second choice. Set false to skip the prompt
# (removal then keeps files; it never silently deletes from disk).
confirm_delete_workspace = true
# Whether to display the full word for the mode chip (e.g., "Normal" instead of "N").
full_mode_chip = true
# Left-click outside an open detail popup (a stat/badge overlay, e.g. the
# disk-usage popup) to dismiss it, just like pressing Escape. Set false to
# require Esc.
dismiss_overlay_on_click_outside = true
# Sidebar workspace (repo) ordering: "manual" keeps your persisted order
# (Ctrl+Alt+↑/↓); "attention" bubbles the workspace whose worktrees most need
# you to the top (stable within a tier — equal-urgency workspaces keep their
# manual order, so rows only move on a real state change). Worktree ordering
# *within* a workspace is the separate sidebar sort mode (`s` opens the sort
# menu: manual/name/recent/attention; manual — rows stay where you put them —
# is the default).
sidebar_workspace_sort = "manual"
# Sidebar TERMINALS section: "always" keeps the banner visible (with a
# "no terminals" hint when empty) so the entry point never vanishes;
# "nonempty" hides the whole section until a terminal exists.
sidebar_terminals_section = "always"
# Shift+Alt+↑/↓ (previous/next workspace) steps one ring: every workspace in
# sidebar order, then every terminal host. By default the ring steps *past* any
# workspace or host you have collapsed — a folded group is one you are not
# working in, so navigation neither stops on it nor expands it. Set false to
# visit every group, folded or not (the old behaviour, which un-collapsed the
# group it landed on). When every other stop is collapsed the step still lands
# on the immediate neighbour, so the keybind never goes dead.
sidebar_nav_skips_collapsed = true
# Pane fullscreen (Ctrl+Alt+z cycles tiled → maximize-in-chrome → full-window):
# in the full-window stop the sidebar/panel/strip are hidden. These keep the
# top masthead and bottom status bars respectively — set either false for a
# more immersive (or fully borderless) fullscreen.
fullscreen_keep_masthead = true
fullscreen_keep_statusbar = true
# Worktree-row display in the sidebar. The main line is the dynamic name (the
# OSC window title a running agent/shell sets), falling back to the branch name.
# The right cluster carries, in order: the dirty status icon, the uncommitted
# working-tree line stat (+adds in green / -dels in red, from [theme.hues]
# green/red), the ↑ahead / ↓behind upstream counts, and a compact open-PR chip
# (⬡N). Each is an independent toggle:
sidebar_show_status_icon = true
sidebar_show_diff_stat = true
sidebar_show_ahead_behind = true
sidebar_show_pr_chip = true
# The focused detail line (branch name + more) hangs under a worktree row while
# the sidebar owns focus. "all" expands every worktree row; "cursor" expands only
# the highlighted row; "off" never shows it.
sidebar_focus_detail = "all"
# Which fields the focused detail line carries (branch name first, then the
# branch's own work over the LOCAL default branch — the same base `thegn diff`
# uses, so a row sitting on the trunk shows nothing — then the open PR;
# env/backend/disk badges always show when present):
sidebar_detail_branch = true
sidebar_detail_branch_stat = true
sidebar_detail_pr = true
# Override the marker glyphs. Empty = the built-ins (↑ / ↓ / ●, which degrade to
# ^ / v / * under ASCII caps). A non-empty override is used verbatim and does NOT
# ASCII-degrade — pick glyphs your terminal renders.
sidebar_icon_ahead = ""
sidebar_icon_behind = ""
sidebar_icon_status = ""

# Visual tuning. The focus accent recolors every thegn surface (plugins,
# pickers, dashboard). `focus_border` frames whatever owns focus — the focused
# pane's border ring, the active tab chip, the active worktree row, and the
# focused chrome edge. Unfocused frames use `colors.border`.
[theme]
# Named palette preset: "prism" (default), "storm", "light", "abyss", "ember",
# "aurora". Cycle live with Ctrl+Alt+t; [theme.colors] / [theme.hues]
# overrides apply on top.
preset = "prism"
accent = "#6ee7d8"
focus_border = "#6ee7d8"
# Horizontal breathing room (cells) between a pane's frame and its content.
pane_padding = 0
# Curly underlines (conflict squiggles): "auto" sniffs the terminal
# ($TERM / $TERM_PROGRAM / $VTE_VERSION); "on" / "off" force it. Unsupported
# terminals degrade to a single underline.
undercurl = "auto"
# Color fidelity. "auto" sniffs the terminal (COLORTERM / $TERM / WT_SESSION /
# NO_COLOR) and degrades truecolor -> 256 -> 16 -> mono as needed; pin a level
# with "truecolor", "256", "16", or "none"/"mono". The NO_COLOR env var forces
# "none" unless you set an explicit value here. (env: THEGN_THEME_COLOR)
color = "auto"
# Glyph fidelity for chrome (box drawing, status dots, arrows, the logotype).
# "auto" sniffs the locale (UTF-8?) and terminal; "unicode" forces the rounded
# Unicode look; "ascii" forces 7-bit fallbacks (+ - | * o ^ v) for bare
# terminals / fonts without box-drawing glyphs. Run `thegn doctor` to see
# what your terminal resolves to. (env: THEGN_THEME_GLYPHS)
glyphs = "auto"
# Marker style for the per-worktree agent indicator in the sidebar tree.
# "letter" (default) uses universal 1-2 letter marks (C=claude, Cx=codex,
# Y=yazi, Lg=lazygit, Ed=editor, D=diff) that render in any font; "symbol"
# uses compact Unicode marks (yazi ⊞, lazygit ↟, editor ✎, diff ±) for
# Nerd-Font / rich terminals, degrading to letters on ASCII-only terminals;
# "auto" uses symbols only on a confirmed-modern emulator. The focused sidebar
# row spells the agent's name out beside its glyph either way.
# (env: THEGN_THEME_AGENT_GLYPHS)
agent_glyphs = "letter"

# Loading-splash mascot drawn above the wordmark when the center is tall
# enough. "owl" (default) — the perched sentinel, whose plumage recolors with
# the active preset; "knight" — the Sutton Hoo helm bust; "off" — no sprite,
# plain wordmark splash.
mascot = "owl"

# Splash-mascot motion. "blink" (default) lets the owl blink, but only on
# wakes that are already repainting the splash — nothing schedules a redraw
# for it, so an idle loop stays at 0% CPU and an idle owl holds its stare.
# "still" pins the eyes open.
mascot_motion = "blink"

# Optional: override any chrome surface/text color (all "#rrggbb"; unset keys
# keep the preset's palette). Invalid hex warns and keeps the default.
[theme.colors]
# bg0 = "#0b0e16"       # deepest background (sidebar)
# bg1 = "#10141f"       # bars / surfaces (tabbar, statusbar, panel)
# panel = "#151a28"     # panel lists
# panel2 = "#1a2031"    # selection / hover
# raise = "#222942"     # raised (context menus)
# border = "#6f788e"    # pane/edge frame lines
# text = "#edf0f8"      # primary text
# dim = "#aab1c5"       # secondary text
# faint = "#7a8197"     # tertiary / labels
# ghost = "#6f788e"     # connectors / disabled (faintest readable tier, ~3:1+)
# ghost2 = "#677084"    # structural glyphs (below ghost)
# ghost3 = "#60687b"    # deepest structural fg (rules, bar tracks)
# shadow_bg = "#05070c" # layer shadow cell background
# shadow_fg = "#1c2233" # layer shadow cell foreground
# chip_fg = "#0b0e16"   # text inside inverse chips (defaults to bg0)
# activity_active = "#edf0f8"   # sidebar dot: agent/worktree working (white)
# activity_waiting = "#ef6f6f"  # sidebar dot: agent waiting for your input (red)

# Optional: override the eight semantic hues (identity + status colors).
# Unset keys keep the preset's hues; legacy presets default to the prism set
# ("light" ships darker, paper-legible hues).
[theme.hues]
# teal = "#6ee7d8"
# magenta = "#ef8fc4"
# purple = "#b69cf2"
# green = "#7fdca0"
# amber = "#e6c264"
# red = "#ef6f6f"
# blue = "#7fb4ec"
# orange = "#f09d6a"

# Resource managers for the top-bar stats widgets (focus the masthead with
# Ctrl+↑, walk the stats with ←/→, Enter opens the stat's history popup).
# `system` backs the CPU and MEM segments; `gpu` backs the GPU segment.
[monitor]
system = "btm"   # CPU/RAM monitor (ClementTsang/bottom); e.g. "htop", "btop"
gpu = "nvtop"    # GPU monitor

# Defaults for the BUILT-IN system monitor (the tabbed modal, opened with the
# `open-monitor` action or by pressing ↵ on a masthead stat chip). These are only
# starting values: `[`/`]`, `g` and `s` change them live per tab, and the choice
# is remembered per tab thereafter.
default_window = "2m"      # 30s | 2m | 10m | 1h | all
default_style = "area"     # area | line | spark
default_scale = "window"   # window (relative to the visible max) | fixed | log
proc_rows = 20             # rows on the Processes tab
# Enumerating every process is the one genuinely expensive sample thegn takes, so
# it runs ONLY while the Processes tab is open and unpaused. Set false to disable
# the tab entirely.
processes = true
process_io = false         # also read per-process disk IO (one extra /proc read
                           # per process; often permission-denied for other users)

# The customizable widget bars framing the workspace. Each slot is an ordered
# list of widget ids; unknown ids are skipped. Top-bar widgets: "brand"
# (thegn + version), "cpu", "mem", "disk" (free space on the worktrees' fs,
# color-coded; see [stats]), "gpu" (NVIDIA only; hidden if absent), "net",
# "date", "clock". Bottom-bar widgets: "keyhints" (context-dependent keybinds
# for the focused zone), "pr" (forge + PR number, state-colored), "tests"
# (✓pass ✗fail rollup of the last test run; green all-pass, red on failure;
# hidden until a run), "loc" (tokei line count), "disk" (the active worktree's
# size, incl. target/), "status" (transient messages).
[bars]
top_left = ["brand"]
# Widgets: cpu, mem, disk (free %), gpu, temp (CPU °C), net, swap, freq (CPU
# GHz), load (1-min load avg, unix only), uptime, battery, date, clock.
top_right = ["cpu", "mem", "disk", "gpu", "temp", "net", "battery", "date", "clock"]
# "help" is the clickable `?` chip that opens the built-in help (same as F1,
# at the page for whatever has focus). Remove it to hide the button.
bottom_left = ["help", "keyhints"]
bottom_right = ["pr", "tests", "loc", "disk", "status"]   # "loc"=tokei line count; "disk"=worktree size
# chrono format strings for the date/clock widgets. Validated at load — an
# invalid specifier warns and falls back to the default rather than panicking
# mid-render. If either renders seconds (%S, %T, %r, %X), the clock ticks once a
# second instead of once a minute; otherwise it wakes only on minute boundaries.
date_format = "%a %b %-d"
clock_format = "%H:%M"

# The calendar popup behind the date/clock widgets (click either, or Alt-d):
# a month grid, a per-day agenda, and world clocks. The grid and clocks need no
# provider at all — only the agenda depends on [[calendar.accounts]].
[calendar]
enabled = true              # false stops event fetching; grid + clocks remain
week_start = "auto"         # "auto" (from $LC_TIME) | "monday" | "sunday" | "saturday"
time_format = "auto"        # "auto" | "12" | "24" — agenda times and world clocks
home_zone = ""              # IANA zone treated as "home"; "" = the system zone
show_week_numbers = false   # ISO week-number gutter down the left of the grid
# Always render six week-rows. On by default: a popup that changes height as you
# page Feb→Mar forces a full-frame repaint and visibly jitters the box.
show_six_weeks = true
show_agenda = true          # the per-day event list under the grid
agenda_rows = 6             # rows before the agenda scrolls
show_event_markers = true   # dot days that have events
ttl_secs = 900              # cache lifetime before a re-fetch is worthwhile
# Default seconds between syncs. Floored at 60 no matter what is written here,
# so a stray 0 can't spin a poll loop against a provider's rate limit.
refresh_interval_secs = 900
max_events = 2000           # cap on cached events per account
horizon_past_days = 90      # how far back to fetch and keep
horizon_future_days = 365   # how far ahead to fetch
reminders_enabled = true    # raise notifications ahead of events
# Reminder offsets (minutes before start) for events whose source supplies none.
# Delivery is the ordinary notification path, so [[notifications.rules]] can
# route, mute, or re-prioritize kind = "calendar_reminder" like anything else.
reminder_default_mins = [10]

# World clocks, in display order. An unknown zone warns and is skipped rather
# than failing startup; `thegn config validate` reports it with a did-you-mean.
# The home row is synthesized, so the block is never empty.
# [[calendar.clocks]]
# zone = "Asia/Tokyo"       # IANA name — required
# label = "tokyo"           # "" derives one from the zone ("New_York" → "New York")
# format = ""               # per-row strftime override; "" inherits time_format
# enabled = true
# show_date = false         # always show the date, not just the ±1d marker

# Where events come from. `name` is the cache key, so it must be unique and
# renaming an account orphans its rows until the next sync.
#
#   provider = "ics"      — a .ics file, or a DIRECTORY of them (the vdir layout
#                           vdirsyncer and khal already write). Needs `path`.
#   provider = "ics_url"  — a subscribed .ics/webcal URL, refreshed with ETag so
#                           an unchanged calendar costs one 304. Needs `url`.
#                           Google, Outlook, Fastmail, Nextcloud and Proton all
#                           publish these, which is why there is no OAuth here.
#   provider = "caldav"   — a CalDAV collection. Needs `url`.
#   provider = "command"  — any program that prints newline-delimited JSON; see
#                           docs/help/calendar.md for the plugin contract.
#
# Sources are read-only: thegn never writes back to a provider.
# [[calendar.accounts]]
# name = "work"
# provider = "ics_url"
# url = "https://calendar.google.com/calendar/ical/…/basic.ics"
# enabled = true
# color = "teal"            # semantic hue name, resolved by the theme (never RGB)
# refresh_interval_secs = 0 # 0 inherits [calendar]; always floored at 60
# token = ""                # "env:VAR" / "file:PATH" — note the URL is a secret too
# username = ""             # caldav: Basic-auth user
# read_only = true
# calendar_ids = []         # caldav: restrict to these collections; [] = all
#
# A local file, or a DIRECTORY of .ics files — the vdir layout vdirsyncer and
# khal already write, so an existing setup needs no extra configuration.
# [[calendar.accounts]]
# name = "personal"
# provider = "ics"
# path = "~/.local/share/calendars/personal"
#
# [[calendar.accounts]]
# name = "khal"
# provider = "command"
# command = ["thegn-cal-khal"]   # argv, not a shell string — no quoting rules
# cwd = ""
# timeout_secs = 20              # then the child's process group is killed
# # What the plugin is allowed to do, as "kind:target". Anything it asks for
# # beyond this is denied and written to the plugin audit log.
# capabilities = ["run:khal"]
# [calendar.accounts.env]
# KHAL_CONFIG = "~/.config/khal/config"

# Top-bar stats widget: icons and refresh rate for CPU/RAM/Network/GPU display.
# Icons can be text ("CPU") or unicode symbols ("⚡"). GPU shows only if detected.
[stats]
refresh_secs = 2           # Polling interval in seconds
# Icons default to single-width Nerd Font glyphs; set plain text if your font
# lacks them. Use single-width PUA glyphs (U+E000–U+F8FF, e.g. nf-fa-*) only —
# the plane-15 Material Design set (nf-md-*, U+F0000+) advances two cells and
# leaves a gap between the icon and its value.
# cpu_icon = "CPU"
# mem_icon = "MEM"
# net_icon = "NET"
# gpu_icon = "GPU"              # shows only if a GPU is detected
# temp_icon = "TMP"             # CPU/package temperature
# swap_icon = "SWP"             # swap usage
# freq_icon = "FRQ"             # CPU frequency
# load_icon = "LD"              # load average (unix)
# uptime_icon = "UP"            # uptime
# battery_icon = "BAT"          # discharging icon
# battery_charging_icon = "CHG" # shown while charging / on AC
battery_warn = 25               # red at/below this percent
# disk_icon = "DSK"             # icon for the "disk" free-space widget
disk_free_warn = 15             # disk widget turns amber at/below this free %
disk_free_critical = 10         # disk widget turns red at/below this free %
# disk_path = "~/projects"      # fs the disk widget measures; "" = worktrees_dir's fs
refresh_rates = [1, 2, 5, 10]  # Click the top-right stats block to cycle

# Threshold alerts on system metrics. A metric must stay past a threshold for
# `sustain_secs` before firing (so a one-sample spike is silent), and a standing
# alert only re-fires every `repeat_secs`. An alert clears once the metric
# retreats past the threshold by `clear_margin` AND holds there, so a value
# hovering on the line cannot flap. A metric the platform doesn't expose (no
# thermal sensor, no load average on Windows) never fires and — importantly —
# never reports "recovered" either.
[stats.alerts]
enabled = true
notify = false        # true also records to the notification inbox; false =
                      # in-app toast only. Off by default: a pegged CPU during
                      # a build should not raise a desktop notification.
sustain_secs = 15     # seconds past the threshold before firing
repeat_secs = 900     # minimum gap between repeats of the same metric+level
clear_margin = 0.05   # 5% retreat past the threshold before clearing
notify_clear = false  # emit a "recovered" event when an alert clears

# `warn` / `critical`: 0 disables that level. cpu/mem/swap/gpu are percent,
# temp is °C, load is per-core (1.0 == fully loaded). disk_free and battery are
# percent and fire when the value falls BELOW the threshold.
cpu  = { warn = 90, critical = 98 }
mem  = { warn = 85, critical = 95 }
swap = { warn = 50, critical = 80 }
temp = { warn = 85, critical = 95 }   # CPU/package °C; absent on Windows
gpu  = { warn = 0,  critical = 0 }    # off by default
load = { warn = 0,  critical = 0 }    # off by default (unix only)
# Left at 0, these two inherit disk_free_warn / disk_free_critical /
# battery_warn above, so each threshold has exactly one place to be set and the
# alert can never disagree with the widget color.
disk_free = { warn = 0, critical = 0 }
battery   = { warn = 0, critical = 0 }

# Prometheus scrape targets for the sidebar METRICS section. thegn scrapes
# each /metrics endpoint directly; no Prometheus server is required. Values are
# filtered by the allowlist below before reaching the UI.
[metrics]
interval_secs = 5        # Scrape interval in seconds (THEGN_METRICS_INTERVAL_SECS)
timeout_ms = 500         # Request timeout in milliseconds
max_body_bytes = 1048576 # Max response size (1 MiB)
# (kebab-case spellings — interval-secs, timeout-ms, max-body-bytes — are
# accepted as aliases.)

# Example: monitor a local model-proxy service.
# [[metrics.targets]]
# name = "model-proxy"
# url = "http://127.0.0.1:9091/metrics"
# metrics = [
#   "http_requests_total",
#   "process_resident_memory_bytes",
#   "model_proxy_active_requests",
#]
# labels = { instance = "local" } # optional exact-match labels

# Bottom file-manager drawer (hidden by default; toggle with Ctrl+Alt+f or
# Alt+y). Runs a pinned, bundled yazi with its own config kept separate from the
# system. Inside the drawer, `q` closes it and `<C-e>` opens the hovered file.
[drawer]
# File manager to run. Empty = the bundled, pinned yazi.
command = ""
# yazi config dir (YAZI_CONFIG_HOME). Empty = a private ~/.thegn/yazi, seeded
# with thegn's bundled config and recolored to match [theme] accent. Use
# "system" to point at your own ~/.config/yazi instead, or give an explicit path.
config_home = ""
# Drawer geometry. height: "35%" or a row count. width: "full" | "center".
height = "35%"
width = "full"
# Image previews are off by default in the bundled/private yazi config. Text/code
# previews remain on. With config_home = "system", thegn does not rewrite your
# yazi config, so containment below is still the safety net.
image_previews = false
# Show git status as a linemode in the drawer (added/modified/deleted/etc.).
# Seeds the bundled git.yazi plugin into the private config and registers it as a
# fetcher; set false to remove it. Ignored with config_home = "system".
git_status = true
# Run yazi and preview helper children in a bounded user systemd scope when
# systemd-run is available. Empty limit strings omit that property.
contain = true
memory_max = "2G"
memory_swap_max = "512M"
cpu_quota = "200%"
# Hidden-drawer keepalive: pool_limit caps how many hidden yazi panes are kept
# warm (oldest evicted past the limit; 0 = hide kills the pane). prewarm spawns a
# hidden drawer for the ACTIVE worktree so even the first open is instant — on by
# default (one memory-capped yazi at a time); set false to never spawn an
# unopened yazi.
pool_limit = 1
prewarm = true

# GitHub PR data feeding the right panel.
[pr]
ttl_secs = 30          # cache TTL before a live `gh` re-fetch (THEGN_PR_TTL)

# Issue-tracker integration — surfaces assigned issues in the Work tab's `issues`
# section. Multiple trackers aggregate into one list, so you can run, say, Linear
# for product work and Jira for a client at the same time.
[issues]
# `providers` aggregates several trackers at once (recommended). When set it wins
# over the single `provider`. Valid: "linear", "github", "jira", "kaneo".
#   providers = ["kaneo", "linear"]
providers = []
# `provider` is the legacy single-tracker form, used only when `providers` is empty.
provider = "none"            # "none" disables the integration
ttl_secs = 60                # cache TTL before a background re-fetch
max_issues = 100             # cap on issues fetched/displayed (per provider)
filter_assignee_me = true    # pre-filter to issues assigned to you
move_on_merge = false        # when a worktree's PR merges, move its linked issue to Done

# [issues.linear]
# api_key = "env:LINEAR_API_KEY"  # `env:VAR` reads from the environment
# team_id = ""                    # restrict to one team ("" = all)
# workspace_slug = ""             # used for issue URLs (inferred if empty)

# [issues.github_issues]
# extra_flags = ["--assignee", "@me"]  # extra `gh issue list` flags

# [issues.jira]
# base_url = "https://myorg.atlassian.net"
# email = "me@myorg.com"
# api_token = "env:JIRA_API_TOKEN"
# project_key = ""                # restrict to one project ("" = all)

# [issues.kaneo]                  # self-hosted, open-source PM (usekaneo.com)
# base_url = "https://kaneo.example.com"  # instance origin (no trailing /api)
# api_key = "env:KANEO_API_KEY"   # API key (Settings → API keys). Empty ⇒ use a
#                                 # token from `thegn kaneo login` (device flow).
# workspace_id = ""               # restrict to one workspace ("" = first)
# project_id = ""                 # restrict to one project ("" = all in workspace)

# Named accounts — MULTIPLE per provider (two Linear workspaces, a personal +
# work GitHub, …), each with its own token + scope, all aggregating into one
# feed. When any `[[issues.issue_accounts]]` exist they are the source of truth
# and the single sub-tables above become a fallback only. The setup wizard
# (`thegn setup`, issue-tracker step) writes these.
#   [[issues.issue_accounts]]
#   name = "work-linear"              # stable id (also the cache key)
#   provider = "linear"              # linear | github | jira | kaneo
#   enabled = true                   # false keeps it in config but un-aggregated
#   token = "env:LINEAR_API_KEY"     # SecretRef / env: — never a raw token
#   team_id = "TEAM-123"             # Linear: restrict to one team ("" = all)
#   workspace_slug = ""             # Linear: URL slug (inferred if empty)
#   base_url = ""                   # Jira/Kaneo: instance URL
#   email = ""                      # Jira: account email
#   project_key = ""                # Jira: restrict to one project ("" = all)
#   workspace_id = ""               # Kaneo: restrict to one workspace ("" = first)
#   project_id = ""                 # Kaneo: restrict to one project ("" = all)
#   extra_flags = []                # GitHub: extra `gh issue list` flags
#   forge = ""                      # optional `[[forges]]` name ("" = default)

# Named git forges — github.com, GitHub Enterprise, self-hosted Forgejo/Gitea.
# CONFIG SURFACE ONLY for now: issue/PR fetch drives the `gh` CLI (github/ghe);
# forgejo/gitea entries are accepted but their fetch is not wired yet (they error
# gracefully). Referenced by `[[issues.issue_accounts]].forge`.
#   [[forges]]
#   name = "corp"                    # stable id
#   kind = "ghe"                     # github | ghe | forgejo | gitea
#   host = "git.corp.example.com"    # API host ("" = the kind's default)
#   token = "env:GHE_TOKEN"          # SecretRef / env: ("" = the CLI's own auth)

# The "My Work" (Mine) panel is scoped to the ACTIVE worktree's repo by default:
# GitHub issues/PRs are auto-filtered to the repo's `origin` remote, so no config
# is needed. To scope Linear/Jira per repo, put an `[issues]` overlay in that
# repo's root `.thegn.toml` — only the keys you set override the global config:
#   [issues.linear]
#   team_id = "TEAM-123"          # this repo's Linear team
#   [issues.jira]
#   project_key = "ACME"          # this repo's Jira project
#   [issues.kaneo]
#   workspace_id = "ws-123"       # this repo's Kaneo workspace
#   project_id = "proj-456"       # this repo's Kaneo project
# To restrict which named `[[issue_accounts]]` this repo aggregates, list their
# names: `[issues]` with `accounts = ["work-linear"]`.
# Press `a` in the Mine section to toggle between this-repo and all-repos views.

# Cross-provider CI/CD inspection — run history, jobs/steps, logs (AV group).
# GitHub Actions reuses the existing `gh`/GH_TOKEN auth (no sub-table needed).
[ci]
provider = "auto"          # auto | none | github | gitlab | drone | woodpecker | jenkins | argo
ttl_secs = 30              # skip non-forced refreshes while cache is younger (0 = off)
poll_interval_secs = 30    # background refresh cadence for run history (min 5)
max_runs = 50              # how many recent runs to fetch/display
log_tail_lines = 2000      # cap on fetched log lines (the tail is kept)

# Per-provider endpoints + tokens. Tokens accept "env:VAR" so secrets stay out
# of this file. Only the provider you use needs configuring.
[ci.gitlab]
host = ""                  # self-hosted base URL; "" = gitlab.com
token = "env:GITLAB_TOKEN"
[ci.drone]
server = "env:DRONE_SERVER"
token = "env:DRONE_TOKEN"
[ci.woodpecker]
server = "env:WOODPECKER_SERVER"
token = "env:WOODPECKER_TOKEN"
[ci.jenkins]
url = ""                   # per-instance Jenkins base URL
user = ""                  # basic-auth user
token = "env:JENKINS_TOKEN"
[ci.argo]
server = ""                # empty = ambient argo/argocd/kubeconfig context
token = "env:ARGOCD_TOKEN"

# Top-level app tab strip. "work" (your worktree IDE) is always present; the
# "Observe" tab appears when [observe] enabled = true (below). Unknown ids ignored.
# Valid ids: "work".
[apps]
default_tab = "work" # initial tab (THEGN_APPS_DEFAULT_TAB); "work" = your worktree
tab_order = ["work"]

# The embedded "Observe" observability app tab: a Grafana-style in-terminal
# dashboard. Off by default (additive). When enabled it shows a built-in
# host-metrics dashboard (CPU/mem/load, sampled locally — no external services);
# point it at Prometheus/Loki and/or a custom dashboard TOML for more.
# Switch to the tab with Alt+2 (or Alt+] to cycle); inside: [r]efresh,
# [ / ] to narrow/widen the window, [esc] back to work.
[observe]
enabled = false               # show the Observe tab in the app strip
refresh_interval_secs = 15    # panel auto-refresh cadence
dashboard_path = ""           # "" = built-in host dashboard; else a dashboard TOML path (~ ok)
[observe.prometheus]
# base_url = "http://localhost:9090"   # empty ⇒ Prometheus panels report "not configured"
# token = "env:PROMETHEUS_TOKEN"       # bearer token; env:VAR / file:PATH / literal
[observe.loki]
# base_url = "http://localhost:3100"
# token = "env:LOKI_TOKEN"

# The per-session daemon that pushes live diff/PR updates to the panel.
[watch]
pr_interval_secs = 20  # PR refresh cadence (THEGN_WATCH_PR_INTERVAL)

# Git write-operation knobs for the panel's lazygit-style features
# (line staging, interactive rebase, cherry-pick, bisect, undo, …).
[git]
override_gpg = false   # true => history rewrites pass -c commit.gpgSign=false
                       # -c tag.gpgSign=false, so a gpg passphrase prompt can
                       # never hang a background operation
merge_guard = true     # install a pre-merge-commit hook that refuses `git merge`
                       # in the canonical checkout from inside a sandbox (where
                       # its FS view can be incoherent and corrupt the merge);
                       # points at `thegn integrate`. No-op outside a sandbox or
                       # in linked worktrees. Escape hatch: THEGN_MERGE_GUARD_OFF=1
auto_fetch = true      # poll the remote in the background (`git fetch --prune`,
                       # never a merge) so the ↓N badge on each sidebar row — and
                       # ⇣N in the panel header — stays current without a manual
                       # fetch. Ambient only: no notification, no toast. Skipped
                       # while offline
auto_fetch_interval_secs = 300      # periodic cadence; 0 = only fetch on startup
                                    # and on switching worktrees. Clamped to >= 30
auto_fetch_min_interval_secs = 60   # floor between two background fetches of the
                                    # same repo, whatever triggered them
auto_fetch_notify = false           # opt in to ALSO get an inbox entry (kind
                                    # `upstream_behind`) when a fetch finds new
                                    # upstream commits. Off by default — the badge
                                    # is the surface. For a transient toast on top,
                                    # see the [[notifications.rules]] example below

# User-defined git commands, surfaced in the git panel's custom-commands menu
# (`x`). `command` is a template expanded against the current selection — see
# the list below — then run via `sh -c`. The `| quote` filter shell-quotes a
# value. Referencing an empty selection is an error, never a silent "".
#   {{.SelectedCommit.Sha}} / .Short / .Subject / .Author
#   {{.SelectedBranch.Name}} / .Upstream      (also .SelectedLocalBranch.*)
#   {{.CheckedOutBranch.Name}} / .Upstream
#   {{.SelectedFile}}   {{.SelectedStash.Index}} / .Message
#   {{.WorktreePath}}   {{.Form.<Key>}}        (a prompt response)
#
# [[git_commands]]
# key = "P"                    # hotkey inside the custom-commands menu
# context = "branches"         # commits | branches | files | stash | global
# command = "git push --force-with-lease origin {{.SelectedBranch.Name | quote}}"
# description = "force-push selected branch"
# output = "popup"             # none | popup | terminal
# prompts = [{ type = "input", title = "Confirm branch", key = "Branch" }]

# Diagnostics. stderr is always on (level-gated, branded, colored on a TTY); the
# file sink is opt-in. THEGN_LOG is a tracing-style filter that refines the
# level per-module, e.g. THEGN_LOG=debug,thegn::db=trace
[log]
level = "info"            # error | warn | info | debug | trace
file = false              # mirror to a rotating file under `dir`
dir = ""                  # "" => $XDG_STATE_HOME/thegn/logs
rotation_size_mb = 5
max_files = 5
format = "text"           # text | json

# ── Keybindings ───────────────────────────────────────────────────────────────
# thegn owns its keybinds. Inspect with `thegn keys list` (add `--zone sidebar`
# / `--zone panel:logs` to scope it, `--json` for machine output); check for
# conflicts with `thegn keys validate` (exits non-zero, so it works in a hook);
# see exactly what a zone's hint strip renders with `thegn keys hints --zone
# sidebar`.
#
# `keys list` covers three sources. Registry actions (`[registry]`/`[host]`) are
# rebindable by id below. **Zone-table** entries — the sidebar's row keys and the
# panel sections' row-mode action keys — are handled by the focused zone itself
# and are NOT rebindable today; they are listed so they stay discoverable.
#
# By default, thegn has four modes: Normal, VimNormal, VimInsert, and Emacs.
# - Normal: The classic `Ctrl` and `Alt` chorded UI.
# - VimNormal: `h j k l` focus moves, `g g`/`G` scrolling, `i` to insert.
#   Also features a `Space` leader layer (e.g. `Space p` for panel).
# - VimInsert: Typing goes to pane. `Esc` back to VimNormal.
# - Emacs: `Ctrl x` / `Ctrl g` layer.
# Switch modes: `Ctrl Alt n` (Normal), `Ctrl Alt v` (VimNormal), `Ctrl Alt e` (Emacs).
#
# Normal-mode defaults follow one modifier grammar, so a chord is predictable
# from its modifiers (rebinds below can break it, but the defaults hold to it):
#   Ctrl     — focus movement only; never creates/destroys an object, so
#              `Ctrl w` stays free for the shell (delete-word).
#   Alt      — object lifecycle + tools; create = `Alt <letter>`
#              (`Alt w` worktree, `Alt t` tab, `Alt p` pane).
#   Alt+Shift— one level up (`Alt w`→`Alt W` workspace; smart-close `Alt x`
#              → `Alt X` remove-worktree).
#   Ctrl+Alt — chrome/UI toggles (sidebar, panel, zoom, theme, notifications…).
# `Alt x` is a smart "close this": the focused pane if the tab is split, else
# the tab. `close-tab` / `close-pane` are explicit, rebindable, no default chord.
#
# Rebind a built-in by its id (see `thegn keys list` for ids).
# Flat entries override chords globally.
# IDE keymap preset overlaid on the built-in defaults: "default" (none),
# "vscode", or "jetbrains". Maps familiar chords (Ctrl+P quick-open, Ctrl+Shift+P
# command palette, Ctrl+B sidebar, …) to existing actions; [keybinds] below still
# override it. On first launch a one-time picker offers these; setting this key
# explicitly skips the picker. The vim/emacs MODES are separate — see [profiles].
# keymap_preset = "vscode"

[keybinds]
# new-worktree = "Alt w"
# toggle-sidebar = "Alt s"
# switch-font = "Alt f"  # opens the realtime font picker (alacritty profile)
# attention-next = "Alt a"  # jump to the next worktree that needs you (default)
# Multi-key sequences (a leader chord) are supported: bind a space-separated
# sequence and a which-key popup lists the next keys after you press the prefix.
# Use "Space"/"leader" for the space key. Sequences are safest in the modal
# vim/emacs modes (in the default mode a bare-key prefix would be intercepted
# before reaching the focused pane), e.g.:
# [keybinds.vim_normal]
# new-worktree = "Space g w"   # press Space, then g, then w
# Sidebar navigation (global):
#   Alt ↑/↓        move to the pane above/below; at the top/bottom pane, cycle
#                  worktrees WITHIN the current workspace (in the TERMINALS
#                  region, cycles terminals within the host). Never focuses
#                  chrome — that is Ctrl ↑/↓.
#   Alt ←/→        move to the pane left/right; at the pane edge, cycle tabs
#                  within the active worktree. Never focuses chrome (Ctrl ←/→).
#   Shift+Alt ↑/↓  switch to the previous/next *workspace* (a real context
#                  switch); at the boundary it overflows into the TERMINALS
#                  region (and its host groups) and wraps back around
#   Alt+`          toggle between the workspaces and TERMINALS regions, restoring
#                  the last item you were on in each
#   Alt+1..9       jump straight to the worktree at that slot in visible order
#   Ctrl+1..9      jump straight to the workspace at that slot in visible order
#                  (the Alt/Ctrl digit hints are revealed on the rows while the
#                  sidebar is focused — Alt+s — and shown in the Ctrl+K menu)
#   Ctrl+Alt ↑/↓   *reorder* (move) the selected item: the workspace under the
#                  sidebar cursor if the sidebar is focused, else the active
#                  worktree within its workspace
# Workspaces and worktrees keep the order you set; cycle worktree sort modes
# with `s` while the sidebar is focused.
# prev-workspace = "Shift Alt Up"
# next-workspace = "Shift Alt Down"
# toggle-region = "Alt `"          # bounce between workspaces and terminals
# summon-workspace-1 = "Ctrl 1"    # …through summon-workspace-9 = "Ctrl 9"
# summon-worktree-1 = "Alt 1"      # …through summon-worktree-9 = "Alt 9"
# summon-pin-1 = "Ctrl Alt 1"      # …through summon-pin-9 = "Ctrl Alt 9"
# move-item-up = "Ctrl Alt Up"     # (legacy id move-worktree-up still works)
# move-item-down = "Ctrl Alt Down"

# You can also scope rebinds to a specific mode:
[keybinds.vim_normal]
# focus-down = "J"

[keybinds.emacs]
# quit = "Ctrl x q"

# Define your own actions — a chord bound to either a shell command (`run`) or
# a built-in composite operation (`action` + `params`). Exactly one of `run` /
# `action` is required. `menu = true` surfaces it in the Cmd+K palette.
# [[actions]]
# name = "deploy"
# key = "Alt D"
# run = "just deploy"
# menu = true
# hint = "deploy"        # short statusbar hint (defaults to `name`)
# floating = true        # run a `run` command in a floating pane (false = tiled)
# close_on_exit = true   # close the pane when the command exits

# Composite actions invoke a built-in operation in-process (a shell `run`
# cannot — thegn is a single session with no IPC). Supported `action`s:
#
#   new-worktree — create a worktree non-interactively (the Alt+w wizard,
#     headless). params: `name` (a tail, or omit/"random" for an adjective-noun
#     name), `sandbox` (auto | podman-rootless | podman-rootful | docker |
#     bwrap | host; default = your configured default backend), `agent`
#     (shell | an [[agents]]/[[tools]] name; default = shell), `base` (source
#     ref; default = configured/auto base).
#
#   new-pane — spawn a pane in the active tab. params: `run` (command via your
#     shell; omit for an interactive shell), `placement` (down | right; default
#     right), `cwd` (worktree | active; default active).
#
#   file-worktree — move the active worktree into a sidebar folder, creating the
#     folder if it doesn't exist yet. params: `folder` (required, the folder
#     name). Bind one per folder you sort into; firing again files into the same
#     folder (no duplicates). The interactive picker is `move-worktree-to-folder`
#     (bindable / in the palette) when you'd rather choose or name a folder.
#     Every folder named by a file-worktree action surfaces automatically as a
#     destination — in that picker, in the Cmd-K palette ("File into: <name>"),
#     and in the which-key popup — even before anything has been filed there.
#
# A scratch worktree on bwrap with a shell, no prompts:
# [[actions]]
# name = "scratch-shell"
# key = "Alt N"
# action = "new-worktree"
# params = { sandbox = "bwrap", agent = "shell" }
# menu = true
#
# A pane tailing the dev log, split to the right:
# [[actions]]
# name = "logs-pane"
# key = "Alt L"
# action = "new-pane"
# params = { run = "tail -f log/dev.log", placement = "right" }
#
# File the active worktree into a named folder (leader: Alt-m-f, then a letter):
# [[actions]]
# name = "File: Ready to merge"
# key = "Alt m f r"
# action = "file-worktree"
# params = { folder = "Ready to merge" }
# menu = true
# [[actions]]
# name = "File: PRing"
# key = "Alt m f p"
# action = "file-worktree"
# params = { folder = "PRing" }
# menu = true

# Keybind profiles: a named layer selected by `profile = "<name>"` (or the
# THEGN_PROFILE env var / --profile flag). Applied *under* [keybinds], so a
# global rebind still wins. `default_mode` sets the host mode on launch. The
# names `vim`/`emacs` also start in the matching mode without an explicit
# default_mode. For the full keybinding cheatsheet, focus the panel and press 9.
# profile = "vim"
# [profiles.vim]
# default_mode = "vim-normal"
# [profiles.vim.keybinds]
# focus-down = "j"

# ── Profiles: whole-process firewall (H) ────────────────────────────────────
# `thegn --profile work` (or THEGN_PROFILE=work) runs a NAMED profile — a
# whole-process work/personal firewall. A named profile reroots its own world
# under ~/.thegn/profiles/<name>/: separate state DB + logs, its own worktrees
# dir, and profile-scoped credentials (GIT_CONFIG_GLOBAL / GH_CONFIG_DIR /
# GNUPGHOME under the profile, forge tokens dropped so they can't cross profiles;
# GIT_SSH_COMMAND pinned with IdentitiesOnly=yes only when profiles/<name>/ssh/id
# exists). The DEFAULT profile keeps today's shared paths untouched — no
# migration. A named profile also loads an optional full-config overlay from the
# REAL config home (never rerooted) at <XDG_CONFIG_HOME>/thegn/profiles/<name>/
# config.toml, layered below env/`--set`. Switch/launch with Ctrl+Alt+g (spawns a
# new terminal window running thegn --profile=<name>); one advisory window per
# profile (a second is warned-about, not refused — profile DBs are WAL-safe).
#
# CAVEAT: the firewall is only as strong as the loosest sandbox setting —
# `[sandbox] file_access = "all"`, `network = "host"`, or SSH agent forwarding
# defeat credential isolation.
#
# Switcher order: the profile switcher (Ctrl+Alt+g) lists profiles in a
# user-controlled order. Reorder the highlighted profile with Ctrl+Alt+↑/↓ while
# the switcher is open; the order is saved to the shared, never-rerooted
# ~/.config/thegn/profiles-order.json (so every profile's window agrees on it).
# The optional seed below is used only until that sidecar exists; names in
# neither are appended alphabetically.
# profile_order = ["personal", "washu", "hubone"]

# ── Identities: decoupled, per-tool credentials (H/AU) ───────────────────────
# A named identity is a REUSABLE set of per-tool credential locations that a
# profile or a bundle references by name — each tool assignable INDEPENDENTLY
# (mix-and-match: git from one identity, gh from another, gpg shared). Any field
# is optional; a tool an identity leaves unset falls through to a less specific
# layer and finally the profile-root default. Switch the active identity at the
# focused scope from the palette ("switch identity"); it takes effect for panes
# spawned afterward. Forge tokens are never set by an identity (they stay
# firewalled), and an SSH key is pinned with IdentitiesOnly=yes.
# [identities.washu]
# accounts    = { claude = "washu" }     # per-provider agent account
# [identities.washu.git]
# config  = "~/.config/git/washu"        # → GIT_CONFIG_GLOBAL
# ssh_key = "~/.ssh/id_washu"            # → GIT_SSH_COMMAND -i … -o IdentitiesOnly=yes
# [identities.washu.gh]
# config  = "~/.config/gh-washu"         # → GH_CONFIG_DIR
# [identities.washu.gpg]
# home    = "~/.gnupg"                   # → GNUPGHOME (shared)
#
# Reference an identity from a profile (its firewall base) or a bundle (soft,
# per-scope; overrides the profile base, and the bundle's own env/config_dirs
# override the referenced identity):
# [profiles.washu]
# identity = "washu"
# [bundle.work]
# identity = "washu"

# Per-workspace overrides, keyed by repo slug (the workspace tab prefix). Applied
# above [keybinds] but below a repo-root `.thegn.{toml,yaml,json}` overlay,
# which may also carry its own [keybinds] table — the most specific layer wins.
# [workspace.my-repo.keybinds]
# new-worktree = "Alt w"

# Per-program host-action overlays, keyed by the focused pane's program name.
# These intercept *before* the active mode — useful for binding a host action
# while a TUI like lazygit is focused.
# [program_keybinds.lazygit]
# palette = "Ctrl Alt k"

# Per-program key-injection remaps: rewrite a chord into the program's own keys
# (the right-hand side is sent to the pane) when it is not claimed as a host
# action. Single keys only.
# [program_remap.lazygit]
# "Ctrl j" = "Enter"

# Coding agents offered in the new-worktree picker.
# Use "__shell__" for a plain login shell.
#
# THIS LIST IS THE SOURCE OF TRUTH for which agents a SANDBOX/sprite provisions
# (installs + carries config/login for): every entry you surface here is set up in
# the sandbox; an entry you remove is NOT (so the picker both surfaces custom agents
# and disables defaults you don't want). The agent KIND is the entry's `provider`,
# else its command's program basename — kinds dedup (e.g. two `claude` entries
# → one `claude`). `[sandbox.home] agents = [...]` overrides this with an
# explicit install list; only when NO `[[agents]]` are configured at all does
# thegn fall back to detecting the host's agents.
#
# `provider` (optional) tags an agent for client-side account switching
# (CODEX_HOME / CLAUDE_CONFIG_DIR) AND fixes its provisioning kind. When omitted,
# it's inferred from the command's program basename (e.g. "codex …" → codex).
[[agents]]
name = "claude"
command = "claude"
# Optional per-entry keys ([[agents]] and [[tools]] share the same shape):
# provider = "claude"   # account-switching / provisioning kind; inferred from the
#                       #   command's program basename when omitted
# hints = [{ key = "Ctrl o", label = "open" }]  # statusbar hint overrides shown
#                                               #   while this program is focused

[[agents]]
name = "aider"
command = "aider --model sonnet"

# ── Managed tools ([managed_tools.<name>]) ──────────────────────────────────
# Per-tool overrides for thegn's managed-tool resolver (the pinned external
# binaries it acquires: the `bs` debugger, MCP servers). The
# resolver picks a binary in a fixed order — this override → the tool's name on
# PATH → thegn's own pinned download under `~/.thegn`. Declare an override
# only to force a specific binary; omit the table to use PATH/managed. Inspect
# resolution with `thegn doctor`.
# [managed_tools.bugstalker]
# path = "/usr/local/bin/bs"      # explicit binary (highest-priority tier)
# args = ["--flag"]               # optional extra launch arguments

# ── MCP servers ([mcp_servers.<name>]) ──────────────────────────────────────
# User-declared Model Context Protocol servers agents consume. Inspect with
# `thegn mcp list` / `thegn mcp emit`; install a server's binary
# (grant-checked) with `thegn mcp install <name>`.
# [mcp_servers.git]
# command = ["npx", "-y", "@modelcontextprotocol/server-git"]  # launch argv
# args    = ["--repo", "."]                                     # extra args
# source  = { type = "npm", package = "@modelcontextprotocol/server-git", version = "0.5.0" }
#                                 # optional: acquire the binary (type = npm | cargo)
# Capability grants gate acquisition (Zed-style, least-privilege): an install is
# refused unless a matching grant covers it. Kinds: process:exec, download_file,
# npm:install, cargo:install. `scope` is a glob (`*` within a path segment, `**`
# across). Omit for none (acquisition then refused).
# [[mcp_servers.git.grants]]
# kind  = "npm:install"
# scope = "@modelcontextprotocol/*"

[[agents]]
name = "shell"
command = "__shell__"

# Per-worktree tools (also bound to Alt-g/y/e//).
[[tools]]
name = "lazygit"
command = "lazygit"
# Optional (same shape as [[agents]] above):
# provider = ""         # account-switching / provisioning kind override
# hints = [{ key = "q", label = "quit" }]  # statusbar hints while focused

[[tools]]
name = "yazi"
command = "yazi"

# "editor" is special: with the default below, thegn resolves your editor
# from $VISUAL/$EDITOR (falling back to vi). Graphical editors are detected by
# name (code, cursor, zed, subl, gvim, …) and launched detached. Set an explicit
# command here to override, e.g. command = "code ." or command = "hx .".
[[tools]]
name = "editor"
command = "${EDITOR:-vi} ."

[[tools]]
name = "diff"
command = "git diff"

# Coding-agent subscription accounts (client-side account switching, item 656).
# Keep N logins per provider (e.g. personal + work) and pick which one a newly
# launched agent uses. thegn points the agent's credential-home env var
# (CODEX_HOME for codex, CLAUDE_CONFIG_DIR for claude) at the chosen account on
# launch — your real ~/.codex / ~/.claude is never modified, and a switch only
# affects agents started *after* it (running ones keep their account).
#
# Switch with Ctrl+Alt+a (or the "Switch agent account" palette entry). The
# picker also has "Add <provider> account…", which runs the provider's login in
# the focused pane against a fresh thegn-managed dir.
#
# Omit `dir` to let thegn manage the dir under
# $XDG_STATE_HOME/thegn/accounts/<provider>/<name>/ (then log in via the
# picker); set `dir` to adopt an existing login dir.
#
# [[accounts]]
# name = "personal"
# provider = "codex"
#
# [[accounts]]
# name = "work"
# provider = "codex"
# dir = "~/.codex-work"   # adopt an existing CODEX_HOME
#
# Make a repo default to an account (resolution: worktree override → this
# workspace default → global active → the CLI's own default home):
# [workspace.my-work-repo]
# accounts = { codex = "work", claude = "work" }
# Bind extra directories into the sandbox for THIS workspace only (same format
# as [sandbox] mounts below). These extend the global mounts; the global list is
# the "all workspaces" scope, this is the "per workspace" scope:
# sandbox_mounts = ["~/datasets:ro", "/opt/toolchain"]
# Default env bundle for this workspace (see [bundle.*] below):
# env_bundle = "work"

# ── Environment bundles (AU) ────────────────────────────────────────────────
# Soft "work vs personal" identities WITHIN one running process — the middle
# ground between per-provider account switching (above) and heavyweight process
# profiles ([profiles.*] / --profile, below). A bundle composes env vars +
# credential/config-dir redirection + account selection (+ optional dotfiles),
# binds at any scope (global / workspace / worktree), and is injected into EVERY
# pane spawn (shells too, not just agents). Switch with Ctrl+Alt+u (or the
# "Switch env bundle" palette entry); it affects panes launched after the switch.
# Precedence: base ◁ extends-chain ◁ global ◁ workspace ◁ worktree ◁ .env.
#
# [bundle.work]
# extends      = ["base"]                       # optional composition (low→high)
# accounts     = { claude = "work" }            # → CLAUDE_CONFIG_DIR (see accounts)
# env          = { ANTHROPIC_BASE_URL = "https://proxy.work", FOO = "env:HOST_FOO" }
# config_dirs  = { GIT_CONFIG_GLOBAL = "~/.config/git/work" }  # Tier-1 redirection
# dotenv       = true                           # opt into the worktree .env (below)
# home         = "managed"                       # Tier-3 synthetic HOME (opt-in)
# zone         = "clientA"                       # owning zone (credential sub-vault)
# [bundle.work.dotfiles]                          # Tier-2 materialized dotfiles
# source = "~/dotfiles/work"
# mode   = "symlink"                              # "symlink" | "template"
#
# Secret values never sit in this file in plaintext — reference them through a
# resolver scheme and thegn runs the command at launch (off-loop, never
# persisted; a failure degrades to skipping the key):
# [secrets.resolvers]
# pass = "pass show {ref}"        # value "pass:work/anthropic" → runs `pass show work/anthropic`
# op   = "op read {value}"        # {value} = the full "op://vault/item/field"
# sops = "sops --decrypt --extract '[\"{key}\"]' {file}"   # {ref} split on last ':' → {file}:{key}
#
# Opt-in `.env`: with `dotenv = true`, a worktree's `.env` loads at LOWEST
# precedence (never overrides a bundle value), only after you allow-list it (the
# switcher prompts), and credential-shaped keys (*_TOKEN/*_KEY/*_SECRET/
# *_PASSWORD) are always dropped — a repo `.env` can never inject a token.

# ── Zones ───────────────────────────────────────────────────────────────────
# A zone is a named group of workspaces INSIDE one profile that provides a soft,
# concurrent firewall — the two-freelance-clients case: both open side by side
# in the same window, each worktree's panes/agents scoped to its zone. Zones sit
# between per-profile process firewalls ([profiles.*]) and per-workspace config.
#
# Split: POLICY lives here in config; MEMBERSHIP lives in the DB (assign with
# `thegn zone assign <zone> [repo]`, never inferred from a filesystem path).
# A zone CLAMPS its members — it never widens: egress intersects down, blocks
# union, sandbox hardening only rises, budget caps roll up. A zone-owned bundle
# (`[bundle.<n>] zone = "..."`) is a credential sub-vault only its members compose.
#
# [zone.clientA]
# env_bundles   = ["clientA-secrets"]           # bundles bound at the zone scope
# network_allow = ["*.clienta.com", "github.com"]  # egress CEILING (members narrow within)
# network_block = ["telemetry.example.com"]     # appended to every member (deny wins)
# sandbox_floor = "hardened"                     # members may only be >= this hardening
# placement_floor = "dedicated"                  # placement-mode FLOOR for members: a
#                                                #   member's requested mode may only be
#                                                #   equal-or-stricter (auto < packed <
#                                                #   dedicated). See [placement].
# [zone.clientA.budget]
# limit_compute_cost = 50.0                      # COMPUTE USD ceiling (placement ledger:
#                                                #   autoscaled hosts + spillover)
#
# Manage zones from the CLI: `thegn zone list|create <name>|rm <name> [--force]|
# assign <zone> [repo]`. Reassignment takes effect on the next worktree launch.

# ── Repo overlay trust ──────────────────────────────────────────────────────
# A repo-root `.thegn.{toml,yaml,yml,json}` is checked into a repository you
# may have cloned, so its `[sandbox]` block is treated as a CLAMPED REQUEST, not
# an override: it may only tighten constraints (network, profile, file_access —
# toward stricter), never widen them (backend/network=host/env_passthrough/
# remote/vpn are denied). Additive requests (mounts, init_script, image, ports)
# are trust-on-first-use gated: review with `thegn repo-trust [path]` and
# approve with `--approve <id>`. Denials/pending are surfaced, never silent, and
# the worktree still opens. `thegn config explain sandbox.<key> --repo <path>`
# shows the full resolution + clamp trace.

# General tasks: surfaced in the Tests panel and, later, Problems/Timeline/Search
# Everywhere. `kind = "test"` makes a task eligible for test discovery/runs.
#
# Tasks come from three sources:
#   1. explicit [[tasks]] entries below;
#   2. static discovery from existing runners/manifests (Justfile, Makefile,
#      Taskfile.yml, package.json, Cargo.toml, go.mod, pyproject.toml,
#      docker-compose.yml/compose.yaml, flake.nix, Procfile);
#   3. semantic aliases such as dev/test/lint/build/up that resolve to the best
#      explicit or discovered task in the current workspace/worktree.
#
# Discovery parses files only; thegn does not execute arbitrary project code
# while switching worktrees. Commands run only after an explicit user action.
#
# [tasks.discovery]
# enabled = true
# providers = [
#   "just",
#   "make",
#   "taskfile",
#   "package-json",
#   "cargo",
#   "go",
#   "python",
#   "docker-compose",
#   "nix",
#   "procfile",
# ]
#
# [tasks.aliases]
# dev = ["just:dev", "npm:dev", "vite:dev", "cargo:run", "compose:up"]
# test = ["just:test", "cargo:test", "npm:test", "pytest", "go:test", "nix:check"]
# lint = ["just:lint", "cargo:clippy", "npm:lint", "ruff"]
# build = ["just:build", "cargo:build", "npm:build", "nix:build"]
# up = ["compose:up", "just:up"]
# logs = ["compose:logs", "just:logs"]
#
# If no test task is configured, thegn falls back to the discovered `test`
# alias/provider chain instead of requiring manual config.
# [[tasks]]
# name = "cargo test"
# kind = "test"
# command = "cargo"
# args = ["test", "--workspace"]
# cwd = "."
# scope = "worktree"
# matcher = "cargo-test"

# [[tasks]]
# name = "pytest"
# kind = "test"
# command = "pytest"
# matcher = "pytest"

# matcher selects how output is parsed. Built-in matchers:
#   text:   cargo-test, go-test, pytest, jest, vitest, swift, ctest, elixir, …
#   json:   nextest, dart, flutter, rspec
#   report: junit (maven/gradle/sbt/php/deno), trx/nunit (.NET, Pester) — set
#           report_glob to the file(s), e.g. report_glob = "target/**/*.xml"
#   tap:    bats, prove (perl), busted (lua), pgTAP, node --test, anything TAP
# [[tasks]]
# name = "bats"
# kind = "test"
# command = "bats --formatter tap ."
# matcher = "tap"

# Worktree templates: reusable presets applied when creating a worktree (run
# "New worktree from template…" from the command palette). A template can set
# the base branch, branch prefix, sandbox backend, and agent (pre-selected in
# the wizard), start a set of pins, and lay out the initial panes. The pane
# layout is either a saved named layout (see "Save layout as…") via `layout`,
# or the `commands` shorthand (an even row-split running each command; "" = a
# plain shell). Pins are matched by name against [[pins]].
# [[worktree_templates]]
# name = "rust-feature"
# base = "main"
# branch_prefix = "feat/"
# sandbox = "podman"
# agent = "claude"
# pins = ["logs"]
# layout = ""              # a saved named layout ("Save layout as…"); wins over `commands`
# commands = ["nvim", "cargo watch -x test"]

# Resource ceilings. thegn NEVER auto-runs tests; these only cap an *explicit*
# run/discovery so a heavy suite can't pin the machine. When `systemd-run` is
# available, runs go in a transient `--user --scope` with these caps; otherwise
# they fall back to `nice`. Empty quota/mem = uncapped; test_nice = 0 disables.
[limits]
# test_cpu_quota = "150%"    # 150% = 1.5 cores for a test run; "" = uncapped
# test_mem_max = "4G"        # memory cap for a test run; "" = uncapped
# test_nice = 10             # niceness for test runs (0 disables)
# test_max_parallel = 1      # max concurrent test/discovery jobs across worktrees
# test_timeout_secs = 1800   # kill a wedged test run after N seconds (0 disables)
# discover_timeout_secs = 45 # discovery should be instant; cap it so a held
#                            #   cargo build-lock surfaces an error, not a spinner
# isolated_target_dir = true # run thegn's cargo under <worktree>/target/thegn
#                            #   so discovery/tests never block on the user's build lock

# Per-worktree disk-usage visibility, cleanup, and shared build caches. Each
# worktree's `target/` is the dominant disk cost when developing across many
# worktrees; these surface it, reclaim it on merge, and dedup compilation.
[disk]
# show_sizes = true            # per-worktree size badges in the sidebar + statusbar total
# warn_threshold_gb = 100      # statusbar warns (amber, red at 2x) above this total; 0 = off
# scan_interval_secs = 45      # background size-scan cadence (runs off the event loop, cached)
# auto_clean_on_merge = true   # `cargo clean` a worktree's target/ when its PR merges
#                              #   (checkout kept; active worktree + running builds skipped)
# clean_on_pr_closed = false   # also clean when a PR is closed without merging
# sccache = false              # inject RUSTC_WRAPPER=sccache into panes (no-op if not on PATH);
#                              #   shares dependency compilation across worktrees
# sccache_dir = ""             # SCCACHE_DIR ("" = sccache default); ~ and repo-relative paths ok
# shared_target_dir = ""       # one CARGO_TARGET_DIR shared across a repo's worktrees.
#                              #   Biggest disk win, BUT cargo's per-target build lock
#                              #   SERIALIZES concurrent builds across worktrees — opt-in.
#                              #   "" = off; ~ expands to home; relative paths resolve to the repo root.

# Session snapshot/restore hardening. Two knobs on the resurrection path: how
# much per-pane scrollback is captured and repainted so a restored pane shows its
# recent history instead of a blank screen, and how long a persisted running/
# active agent dot may age before it is coerced to a settled state at restore —
# so a session killed mid-run never resurrects a phantom forever-running dot.
[session]
# scrollback_lines = 500       # max plain-text scrollback lines captured per pane on
#                              #   snapshot and repainted on restore; 0 = disable (blank restore)
# restore_grace_secs = 600     # a persisted active/running activity dot older than this at
#                              #   restore is downgraded to a settled state; live FSM untouched
# focus_on_create = true       # creating a worktree (Alt+w) jumps to its new tab and shows the
#                              #   loading splash; false = build in background with a sidebar dot
# resident_pool_limit = 16     # max PARKED workspaces kept resident (panes alive) for instant
#                              #   switch-back, beyond the active one; the least-recently-used is
#                              #   evicted (its panes reaped, re-resurrected on next visit) past
#                              #   this, bounding PTY fd/thread growth over a long session; 0 = no
#                              #   pooling (reap on every switch)

# Aggregated notification bus. Events (PR state, agent done/failed, test
# failures, log errors, worktree created) surface as sidebar badges + the
# in-app inbox, and optionally as OS desktop notifications.
#   desktop             — deliver OS toasts (Linux: notify-send, macOS: osascript)
#   desktop_min_urgency — "low" | "normal" | "critical"; events below this
#                         urgency stay in the inbox but never pop a toast
[notifications]
desktop = true
desktop_min_urgency = "normal"
# How non-agent pane exits join the attention model (item 524):
#   "failures_and_tasks" — crashes/non-zero exits + clean non-shell task panes (default)
#   "failures"           — only non-zero exits
#   "all"                — every non-agent exit, including clean interactive shells
#   "off"                — never route pane exits
process_exit = "failures_and_tasks"
# Surface thegn's own log errors ("N errors in thegn.log") as user
# notifications. Off by default — they are internal diagnostics, always written
# to thegn.log on disk regardless. A dev flag; even when on they stay quiet
# (informational, never the red flag, never in "Needs you") and appear as a
# single entry point under the unified surface's Logs group.
surface_self_log_errors = false
# Poll GitHub's notifications API for @mentions of you in the active repo
# (`gh api notifications`, reason == "mention") and surface them as the
# "mentioned" kind. Throttled to one call per repo per 5 minutes on the
# PR-refresh cadence; each mention notifies once. Requires `gh` auth; the
# poll is skipped silently without it.
github_mentions = true
# Startup routing mode ("" = default). Named modes are defined below in
# [notifications.modes.<name>]; switch at runtime with Ctrl+Alt+m.
active_mode = ""

# Per-kind attention priority. Three tiers drive the badges coherently:
#   "alert"  — raises the red ⚑ flag (panel header + sidebar + statusbar) and,
#              mapped to "critical" urgency, a desktop toast
#   "notice" — counts toward the neutral "N unread" badge, never the red flag
#   "info"   — inbox history only; never counted toward any badge
# Defaults: failures (agent_failed, test_failed, process_failed,
# queue_needs_human) are "alert"; lifecycle/diagnostic events (log_error,
# worktree_created, process_exited, queue_landed) are "info"; everything else (assigned,
# mentioned, status_changed, blocker_resolved, pr_linked, overdue,
# pr_state_changed, agent_done, queue_ready) is "notice". Override any kind
# below (keys are the snake_case kind names). Unknown keys/values are ignored.
# The queue_* kinds are the merge queue's settled transitions ([merge_queue]).
# [notifications.priority]
# agent_done = "alert"        # promote: flag me when an agent finishes
# worktree_created = "notice" # demote less: show in the unread count
# pr_state_changed = "info"   # silence: inbox-only

# User routing rules (item 420). Evaluated top-to-bottom at delivery time; a rule
# fires when EVERY present selector matches (absent selectors are wildcards):
#   kind / kinds       — a single kind or a list (snake_case names)
#   worktree           — glob over the worktree path (`*` any run, `?` any char)
#   source             — prefix of the source ref ("linear:", "pr:", …)
#   message            — regex matched against the message text
#   min_priority       — only fire at/above "info"|"notice"|"alert"
#   modes / profile    — only under this active routing mode / profile
# Actions: set_priority ("info"|"notice"|"alert"), route (a subset of
# "inbox"/"desktop"/"toast"/"sound"), mute (drop ephemeral channels, keep inbox),
# drop (drop entirely), sound ("bell"|"off"|<command>), stop (halt evaluation).
# [[notifications.rules]]
# name = "mute scratch worktrees"
# worktree = "*/scratch"
# mute = true
# [[notifications.rules]]
# message = "flaky|known-issue"
# drop = true
# [[notifications.rules]]
# kind = "agent_done"
# set_priority = "alert"      # sound + break through DND when an agent finishes
# [[notifications.rules]]
# kind = "upstream_behind"    # needs [git] auto_fetch_notify = true to fire at all
# route = ["inbox", "toast"]  # pop a transient in-app toast, not just an inbox row
# All selectors / actions on one rule (each is optional):
# [[notifications.rules]]
# name = "work-hours PR alerts"
# kinds = ["pr_state_changed", "agent_done"]  # multi-kind selector (or `kind = "…"`)
# worktree = "*/work-*"       # glob over the worktree path
# source = "pr:"              # source-ref prefix ("linear:", "pr:", …)
# message = "urgent"          # regex over the message text
# min_priority = "notice"     # only fire at/above this priority
# modes = ["focus"]           # only under these routing modes (see below)
# profile = "work"            # only under this active profile
# set_priority = "alert"      # action: raise/lower the priority
# route = ["inbox", "desktop"] # action: restrict delivery channels
# sound = "bell"              # action: "bell" | "off" | a command line
# stop = true                 # action: halt rule evaluation here

# Do-not-disturb / quiet hours (item 426). During DND, notifications below
# `allow_priority` stay in the inbox but pop no desktop toast, in-app toast, or
# sound. Toggle at runtime with Ctrl+Alt+d (the toggle overrides the schedule).
#   windows — "HH:MM-HH:MM" ranges (may wrap past midnight) with an optional
#             leading weekday token ("Sat", "mon-fri", "sat,sun").
# [notifications.dnd]
# enabled = false
# windows = ["22:00-08:00", "sat,sun 00:00-24:00"]
# allow_priority = "alert"

# Sound / chime (item 429). `mode`: "chime" (default — a bundled chime played
# through an auto-detected system player: paplay/pw-play/afplay/PowerShell/…,
# falling back to the terminal BEL), "bell" (terminal BEL), "command" (run a
# command line off-thread), or "off". Fires at/above `min_priority` EXCEPT for
# the `always_kinds` list, which chimes regardless (so a background agent that
# finishes or needs you is audible out of the box). `suppress_focused` silences
# the cue for the worktree you're currently viewing (the inbox record + desktop
# toast still fire). `chime_file` points `mode = "chime"` at your own .wav.
# [notifications.sound]
# mode = "chime"
# min_priority = "alert"
# always_kinds = ["agent_done", "agent_attention", "agent_failed"]
# suppress_focused = true
# chime_file = "~/sounds/ding.wav"     # optional custom chime (default: bundled)
# command = "paplay /usr/share/sounds/freedesktop/stereo/complete.oga"  # mode = "command"
# [notifications.sound.per_priority]   # optional per-priority command overrides
# alert = "paplay /usr/share/sounds/freedesktop/stereo/dialog-warning.oga"

# Routing modes (item 427): named presets you switch between at runtime with
# Ctrl+Alt+m. A rule's `modes` selector limits it to the listed modes;
# `active_mode` sets the startup mode ("" = default). Per-profile overrides live
# under `[profiles.<name>.notifications]` (same keys as `[notifications]`).
# active_mode = ""
# [notifications.modes.focus]
# label = "Heads down"
# [notifications.modes.away]
# label = "Away"

# Top pinned-program strip: a horizontal band above the center that renders
# `location = "strip"` pins side by side (toggle Ctrl+Alt+b; grow/shrink at
# runtime). `ratio` is the fraction of the center band it occupies.
[strip]
ratio = 0.2
visible = true

# The right accordion panel. Four top-level tabs (git/work/system/help) group
# sections by concern; `Tab` / `Shift+Tab` cycle tabs, bare digits 1-9 jump to
# the active tab's Nth section.
# `sections` reorders sections across all tabs — any section left out is hidden;
# an empty/absent list shows every section in the built-in order:
#   Git tab:    changes · commits · branches · stash · files
#   Work tab:   mine · across · pr · ci · merge · issues · problems · jobs
#               · tests · symbols
#   System tab: notifications · logs · sandbox · hosts · environments · share
#               · forward · telemetry · media · keys
# "mine" is the "My Work" feed (assigned issues across all trackers +
# review-requested/authored PRs + high-priority notifications), scoped to the
# active repo by default ("a" widens to all repos). "across" aggregates other
# worktrees' failing CI, scoped to the active workspace ("a" widens).
# The old "prs" and "tasks" keys still work as aliases for "pr" and "jobs".
# Unknown keys are ignored; reloads apply live.
[panel]
# sections = ["changes", "pr", "files", "tests", "telemetry", "keys"]
# When Esc returns focus to the center terminal from any chrome zone (sidebar,
# panel, a bar, the drawer), snap the right panel back to its default width and
# close the bottom file drawer. Set false to leave sizes exactly as you left them.
# collapse_on_escape = true
# Resting (Normal) panel width in columns (clamped 30–200; default 44). Dragging
# the panel's left separator with the mouse adjusts and persists this too — a
# dragged width wins over this key until the drag memory is cleared.
# width = 44
# Fraction of the screen the Half (first `e`) width takes (clamped 0.30–0.90;
# default 0.5). Never narrower than the Normal width.
# half_ratio = 0.5

# In-pane scrollback / copy-mode search (distinct from the palette below).
[search]
# Max fuzzy-matched results returned per search (capped at the visible rows).
max_results = 1000

# Search Everywhere palette (Ctrl+Space). Mode prefixes:
#   (none) = All (actions + recent files)   > = Files   / = Content
#   ~      = Worktrees (frecency opener)    @ = Git refs/commits/stashes
#   #      = Symbols
# Tab cycles modes; Esc closes.
#
# Navigation (no config needed):
# - `~` lists workspaces + worktrees ranked by frecency (open count × recency
#   decay, 7-day half-life) — type a fragment, Enter lands in that worktree's
#   tab. Every palette pick feeds the ranking.
# - "Connect to root" (palette command) jumps from the focused pane's cwd —
#   however deeply nested — to the tab of the worktree that owns it; a cwd
#   outside any registered workspace offers to add it.
# - "Clone and open" (palette command) takes a git URL, clones it off the
#   event loop into `workspaces_dir`, registers the workspace, and opens its
#   first worktree tab. (Alt+W manual entry does the same.)
# - Layout import: tmuxinator projects (`~/.config/tmuxinator/*.yml`) and sesh
#   sessions (`~/.config/sesh/sesh.toml`) appear automatically as templates in
#   the new-worktree template picker (window commands → an even pane split);
#   `[[worktree_templates]]` entries win name collisions. Read-only.
[palette]
# content_max_results = 500    # max grep matches before streaming stops
# file_max_results    = 200    # max file-path fuzzy results
# symbol_max_results  = 100    # max symbol grep results
# content_search_hidden = false  # include dotfiles / .gitignored paths

# Language-server integration: symbol search, go-to-definition, hover, and
# diagnostics. Servers start lazily on first use and stay warm per worktree.
# Built-in defaults (used only when found on PATH): rust-analyzer,
# typescript-language-server, pyright-langserver, gopls. Falls back to the
# tree-sitter / regex providers when no server is available.
[lsp]
# enabled = true               # master switch
# hover   = true               # show hover / signature previews
#
# The `enabled` switch also gates the semantic blast-radius (items 313/316): the
# `◈ semantic` diff footer's "N callers/F files · U untested · risk:R" tail and
# the `blast_radius` MCP house tool. Edges are sourced from the language server's
# `textDocument/references`, so with `enabled = false` (or no server for the
# diff's language) the graph contributes nothing and the footer falls back to its
# intra-diff entity summary — the feature is strictly additive.
#
# Per-language server overrides. `lang` is one of rust / typescript / tsx /
# javascript / python / go. `command = ""` disables that language.
# [[lsp.servers]]
# lang    = "rust"
# command = "rust-analyzer"
# args    = []

# Pinned programs: summoned from anywhere with Ctrl-Alt-1..9 (in registration
# order; Alt-1..9 jumps to worktrees, Ctrl-1..9 to workspaces) or the tabbar's
# pin chips. Pins run on the host (no sandbox) and are managed by
# a supervisor (eager start, restart policy, health, survive workspace switches).
#
#   location = "tab"    opens/focuses a dedicated `pin:<name>` tab (default)
#   location = "layout" adds a tiled pane to the focused tab's active layout
#   location = "strip"  renders the pin in the top strip
#   location = "float"  opens the pin as a floating scratch overlay
#   scope    = "global" (default) | "workspace"   (workspace = which workspace)
#   start    = "lazy" (default) | "eager"         (eager = launch at session start)
#   restart  = "never" (default) | "always" | "on-failure"
#   singleton = true (default)                    (false = allow multiple instances)
#
# Optional: `args` (explicit argv, skips the shell), `env` (per-program vars),
# `label` (strip/chip text), `ratio` (this pin's weight in the strip). For layout/
# strip pins, omitted cwd means the focused repo/worktree if resolvable; for tab/
# float pins, omitted cwd means $HOME.
#
# location = "corner" docks the pin as a small bordered overlay in a screen
# corner (toggle with Ctrl+Alt+o), sized by `corner_width`/`corner_height`
# ("30%" of the screen, or an absolute cell count) and anchored by `corner`
# ("bottom-right" (default) | "bottom-left" | "top-right" | "top-left"). A single
# corner pin is live at a time. Great for a video player; audio plays through your
# normal system audio, and YouTube works via mpv's yt-dlp integration (pass a URL).
#   - On a kitty-graphics terminal (Ghostty, kitty, WezTerm) use `mpv --vo=kitty`
#     for CRISP pixel video: thegn relays the corner's kitty images to the outer
#     terminal, offset to the corner rect (auto-detected).
#   - Elsewhere use `mpv --vo=tct` — colored Unicode half-blocks (text+truecolor),
#     blocky but works on any terminal.
# [[pins]]
# name = "aerc"
# command = "aerc"
# location = "float"
#
# [[pins]]
# name = "video"
# command = "mpv --vo=kitty --really-quiet"   # or "--vo=tct" on non-kitty terminals
# location = "corner"
# corner = "bottom-right"
# corner_width = "30%"
# corner_height = "30%"
#
# [[pins]]
# name = "logs"
# command = "journalctl -f"
# args = []                # explicit argv (non-empty ⇒ launched directly, no shell)
# location = "strip"
# scope = "global"         # "global" (all workspaces) | "workspace"
# workspace = ""           # owning workspace (only used when scope = "workspace")
# singleton = true         # false = allow multiple instances
# start = "eager"
# restart = "always"
# label = "syslog"
# ratio = 1.5
# cwd = "~"
# env = { RUST_LOG = "info" }

# ── Batteries-included toolchain ─────────────────────────────────────────────
# How a sandbox/remote gets its language toolchains when the repo declares
# nothing but language manifests (package.json, pyproject.toml, go.mod, …) —
# i.e. no flake devShell / devenv / shell.nix / .tool-versions. By default
# thegn SYNTHESIZES a Nix devShell covering the detected languages (written
# to $HOME/.thegn/synth/<hash> in the sandbox and warmed during
# provisioning), instead of crude best-effort apt installs. Repos that declare
# their own environment are untouched — this table only governs the fallback.
[toolchain]
# mode = "auto"   # "auto"|"nix" = synthesize a Nix devShell (default);
#                 # "mise" = install runtimes via mise instead;
#                 # "off"  = legacy best-effort native (apt) runtimes
# Per-language nixpkgs package lists. An empty list (the default) uses the
# built-in mapping shown below; a non-empty list REPLACES it for that language.
# (Rust has no entry — rustup ships in the sandbox base image.)
# python = ["python3", "uv"]
# node = ["nodejs_22"]
# deno = ["deno"]
# jvm = ["jdk21", "sbt", "scala-cli"]
# go = ["go"]
# ruby = ["ruby"]
# extra = []      # nixpkgs packages appended for every language mix

# ── Sandbox / containers ──────────────────────────────────────────────────────
# Run each worktree's interactive process (agent/shell/tools) inside a
# container/sandbox. The git worktree stays on the host and is bind-mounted in
# at its real path, so the sidebar/panel/PR (which read git host-side) keep
# working while the agent/shell only sees the worktree and its git metadata.
#
# Backend comparison (for NixOS / host-toolchain users):
#   bwrap           — bubblewrap: no daemon, no image, sub-millisecond spawn.
#                     Exposes the host filesystem selectively; your Nix-store
#                     shell and tools are available without any extra mounts.
#                     Best default for NixOS users who just want containment.
#   podman-rootless — OCI image (Debian, Ubuntu, custom). Reproducible env,
#                     persistent named container, but ~50-200 ms per spawn and
#                     the host shell path (/run/current-system/sw/bin/zsh)
#                     doesn't exist inside the image — thegn probes for
#                     zsh/bash/sh at runtime and uses the first one found.
#   host            — no sandbox; process runs directly in the worktree dir.
#
# Per-repo overrides go in `.thegn.{toml,yaml,yml,json}` at the repo root
# under a `[sandbox]` table — only the keys you set override these globals.
[sandbox]
enabled = true

# ── Hardening preset ─────────────────────────────────────────────────────────
# A named bundle of OS-isolation knobs applied to the worktree's container.
# Selectable per level: here (global), per workspace/repo via a `.thegn.toml`
# overlay, or the THEGN_SANDBOX_PROFILE env var.
#   open     — no hardening; pre-preset behavior (escape hatch / back-compat).
#   hardened — read-only root + no-new-privileges + a process (pids) cap, with
#              networking and Linux capabilities left intact so interactive dev
#              (fetch/clone/build, debuggers, ping) keeps working. The default.
#   sealed   — full lockdown: network=none, read-only root, drop ALL caps,
#              no-new-privileges, tighter pids cap. For untrusted workloads.
# Under a read-only-root profile (hardened/sealed, the default), everything
# OUTSIDE the worktree is read-only — including your $HOME — so a sandboxed
# agent can't `cd` out and modify/delete host files. Writable: the worktree, its
# git dir, build caches, /tmp, and a narrow set of $HOME carve-outs for shell
# state (~/tmp, ~/.local/state, ~/.local/share, plus the legacy history files
# ~/.zsh_history and ~/.bash_history). ~/.keychain is carved for interactive
# (hardened) panes but NOT the sealed agent — it stores scripts your host login
# shells later *source*, so a writable ~/.keychain from a sealed sandbox would
# be a persistence vector. Coding-agent config dirs (CLAUDE_CONFIG_DIR /
# CODEX_HOME, or the ~/.claude / ~/.codex default) are also carved writable — for
# EVERY non-sealed pane, so an agent CLI you run *manually* in a sandbox shell
# can persist its runtime state (session-env, todos, shell snapshots) instead of
# its startup hooks dying "read-only file system". ~/.claude-profiles is carved
# too, for HOME-swapping profile wrappers (claude-profile / claude-multiplex).
# `profile = "open"` restores a fully-writable $HOME (zsh history/zoxide/
# keychain) as the escape hatch; add more writable paths under `mounts` below.
profile = "hardened"

# ── Backend selection ────────────────────────────────────────────────────────
# Which containment backend to use. "auto" walks backend_chain until one works.
#   auto | podman-rootless | podman-rootful | docker | bwrap | bubblewrap |
#   systemd | systemd-run | apple | container | wsl | none | host
# NixOS tip: set "bwrap" here to skip the podman probes and get instant panes.
backend = "auto"

# Pre-selected backend in the new-worktree picker ("auto" = use backend_chain).
default_backend = "auto"

# The named execution environment (`[env.<name>]`, documented below) every
# worktree uses by default unless it/its workspace/repo selects another. Empty
# = the implicit "default" env (this `[sandbox]` block + `[sandbox.remote]`).
default_env = ""

# Branch-aware override of `default_env` for a worktree on the repo's PRIMARY
# branch (origin/HEAD — e.g. main/master). Empty (default) = branch is never
# consulted and `default_env` applies to every branch. Set both to run the main
# checkout locally while feature branches go to a remote provider, e.g.:
#   main_env    = "host"        # `[env.host]`     placement = "local"
#   default_env = "machine0"    # `[env.machine0]` placement = "provider"
# Applies below explicit worktree/workspace/repo selections. A repo `.thegn.toml`
# may NOT set this (like `default_env`) — a repo picks its env via the top-level
# `env = "…"` key instead.
main_env = ""

# Probe order for "auto". First backend that is installed and usable wins.
# "none"/"host" anywhere in the list = uncontained fallback from that point on.
# One list serves every OS: each OS-native entry probes Absent off its own OS.
# NixOS users: move "bwrap" first if podman isn't installed.
# macOS: "apple" is Apple's `container` CLI (each container gets its own Linux
# VM, so it is the strongest isolation any backend offers). It is probed only on
# macOS; "bwrap"/"systemd" are Linux-only, so a Mac with no runtime installed
# lands on "host" and panes just run directly.
# Native Windows: the OCI entries decline (Linux containers can't bind-mount
# the worktree at its real path — use WSL2 for container sandboxes); panes are
# scoped by "jobobject" (kill-on-close Job Objects) instead.
backend_chain = ["podman-rootless", "podman-rootful", "docker", "apple", "bwrap", "jobobject", "host"]

# ── OCI image (podman / docker only) ────────────────────────────────────────
# Empty  = thegn's built-in default (debian:stable).
# Named  = pulled on first use (e.g. "ghcr.io/org/devenv:latest").
# bwrap / systemd ignore this — they use the host filesystem directly.
image = ""

# Docker Compose file to bring up before the first pane in a workspace.
# The named container is expected to be running when panes are spawned.
# compose = "docker-compose.yml"

# ── Network ──────────────────────────────────────────────────────────────────
# nat  — egress only, no inbound ports. Required for API-backed agents.
# host — share the host network stack (no isolation; fastest for local services).
# none — no network (offline/air-gapped agents).
network = "nat"

# Host ports to publish from the container: ["host_port:container_port", ...].
# E.g. expose a dev server started by the agent on port 3000:
# ports = ["3000:3000", "8080:8080"]
ports = []

# Outbound hostname policy, enforced via a per-container DNS interceptor.
# Allow-only these hostnames (empty = allow all); the block list wins when a
# hostname matches both.
network_allow = []
network_block = []
# Log all outbound DNS queries and connection attempts to the audit table.
network_audit = false

# ── Filesystem ───────────────────────────────────────────────────────────────
# How much of the host filesystem the sandbox can see:
#   worktree            — only the worktree dir (most isolated).
#   worktree_plus_caches — worktree + auto-detected language build caches
#                          (~/.cargo, ~/.npm, ~/.cache/pip, etc.). Default.
#   all / host          — entire host filesystem (read-write, least isolated).
#   none                — no filesystem access beyond the container root.
#   custom              — only the explicit mounts list below.
# Note: regardless of file_access, the default `hardened` profile makes
# everything outside the worktree/caches READ-ONLY (see `profile` above). To get
# a fully writable host filesystem use `file_access = "all"`; for the strictest
# scoping use `"custom"`/`"none"`. Both file_access and profile are overridable
# per-repo via a `.thegn.toml` overlay.
file_access = "worktree_plus_caches"

# Mount common language build caches from the host when file_access is
# worktree_plus_caches. Disable to get a fully cold cache on every pane.
auto_caches = true

# Extra bind mounts beyond what file_access provides.
# Formats: "host_path"              → rw at same path inside container
#          "host_path:ro"           → read-only at same path
#          "host_path:dest"         → rw at dest inside container
#          "host_path:dest:ro"      → read-only at dest
#          "host_path:dest:cache"   → read-write cache (shown in sandbox summary)
# ~ is expanded to $HOME.
# This is also the extension point for extra writable carve-outs under the
# read-only $HOME: a read-write DIRECTORY under $HOME (e.g. "~/.gnupg") is kept
# and overmounts the read-only parent. An EXISTING FILE is carved the same way
# (e.g. "~/.histfile" for a custom history path) — bwrap overmounts the existing
# inode. Only a NON-existent path can't be carved (bwrap can't create the
# mount-point under the read-only $HOME). A read-only FILE (e.g.
# "~/.gitconfig:ro") is served read-only by the $HOME bind.
# This is the GLOBAL ("all workspaces") scope for default bind dirs. For a
# single workspace, add `sandbox_mounts` under `[workspace.<slug>]` (see above);
# those extend this list. A repo-root `.thegn.toml` `[sandbox] mounts` can
# also override per repo.
mounts = ["~/.gitconfig:ro"]

# ── GPU passthrough (OCI only) ───────────────────────────────────────────────
# Expose a GPU device to the container. Values depend on the runtime:
#   "all"             — all GPUs (--gpus all / --device nvidia.com/gpu=all)
#   "/dev/dri/card0"  — specific device path
# Leave commented to disable GPU passthrough.
# gpu = "all"

# ── Environment ──────────────────────────────────────────────────────────────
# Host env vars forwarded into the SANDBOX. Extend this list if your agent needs
# additional credentials or toolchain vars.
#
# NOTE: separately, EVERY pane (sandboxed or not) is spawned clear-then-allowlist
# — it does NOT inherit thegn's whole environment, so the launching shell's
# GH_TOKEN / ANTHROPIC_API_KEY / SSH_AUTH_SOCK etc. do not leak into panes. A
# curated infrastructure base (PATH/HOME/locale/terminal/display + the XDG/DBus
# vars a rootless runtime needs) is seeded, then the pane's bundle/profile
# identity is layered on. To re-admit a specific var into a plain (non-sandbox)
# shell, set it via a [bundle.*] `env` entry.
env_passthrough = [
  "SSH_AUTH_SOCK",      # SSH key forwarding (needed for git push inside OCI)
  "GH_TOKEN",           # GitHub CLI auth
  "GITHUB_TOKEN",       # GitHub Actions / API compat alias
  "ANTHROPIC_API_KEY",
  "TERM",
  "COLORTERM",
  "GIT_CONFIG_GLOBAL",  # profile git identity into the sandbox (H)
  "GH_CONFIG_DIR",      # profile gh config into the sandbox (H)
]

# ── Shell ─────────────────────────────────────────────────────────────────────
# Shell for plain "shell" panes inside the sandbox.
# ""   = auto: for OCI containers thegn probes zsh → bash → sh at runtime
#        so it works even when the image doesn't have the host shell installed
#        (e.g. a Debian image has bash but not /run/current-system/sw/bin/zsh).
#        For bwrap / host the host's $SHELL path is used directly.
# Set an explicit name ("bash") or absolute path ("/usr/bin/zsh") to pin one.
shell = ""

# ── Init script ───────────────────────────────────────────────────────────────
# POSIX sh snippet run INSIDE the sandbox before each agent/shell starts (runs
# in every pane, before the login shell `exec`s). Useful for first-run tool
# installation, env setup, or container git config.
# init_script = "mise install 2>/dev/null || true"
init_script = ""

# ── Prepare hooks (host-side, one-time per worktree) ──────────────────────────
# Commands run ON THE HOST (off-loop, via `sh -lc` in the worktree) once when a
# worktree is created, before its first pane spawns. Unlike `init_script` these
# run on the host — with the writable Nix store, the Nix daemon, and full
# network — so they suit heavyweight setup that a sandboxed pane can't do
# itself. The built-in `direnv` warm (`warm_direnv`, below) runs alongside them.
# prepare = ["mise install || true", "pnpm install --frozen-lockfile || true"]
prepare = []

# ── direnv ────────────────────────────────────────────────────────────────────
# Pre-warm a worktree's `direnv` cache on the HOST so the in-sandbox `direnv`
# hook actually works. A worktree pane is a login shell, so your rc's `direnv
# hook` fires inside the sandbox; with `use flake`, a cold nix-direnv cache makes
# direnv rebuild the devShell — which writes/locks `/nix/store` and fails on the
# sandbox's read-only store (no daemon). Warming on the host (writable store +
# daemon) means the in-pane direnv replays the cached env read-only instead.
#   "auto"         — warm + `direnv allow` the worktree (trusts the repo's own
#                    .envrc, the same boundary `inject_devshell` already crosses)
#   "allowed-only" — warm only worktrees you've already `direnv allow`-ed
#   "off"          — never warm (the in-pane direnv falls back as before)
warm_direnv = "auto"

# Wrap the inner command in `devenv shell --`. Auto-enabled if devenv.nix is
# present in the worktree root and the `devenv` binary is on PATH.
devenv = false

# ── Nix devShell tooling ──────────────────────────────────────────────────────
# Tier A (read-only, safe): inject the repo's Nix flake `devShell` toolchain
# (its PATH + safe exported vars) into worktree panes. thegn resolves the
# devShell on the HOST (writable store + daemon) via `nix print-dev-env`, caches
# it under $XDG_STATE_HOME/thegn/devenv/, and prepends it to the pane's PATH —
# so a sandboxed pane that can't reach the Nix daemon still gets the project's
# linters/formatters/tools out of the box. No-op for repos without a devShell.
inject_devshell = true
# Which flake devShell a sandbox/sprite enters. Empty = the flake default (same as
# host dev — the FULL closure). Set to a leaner attr so a remote sprite builds/seeds
# a much smaller closure. thegn's own flake ships two lean attrs: "sandbox" (rust +
# just only) and "sprite-full" (the full lint/test/coverage/openspec replica MINUS
# rust-docs, the darwin/windows cross-targets, and the muse e2e harness — so
# `just ci` works, but not `just check-cross`/`just e2e`). Exported as THEGN_DEVSHELL
# into the sandbox; the repo's `.envrc` must read it and enter the matching flake
# devShell when set (`use flake ".#$THEGN_DEVSHELL"`) — thegn's own `.envrc` does
# this, using devenv only on the host where THEGN_DEVSHELL is unset. Missing tools are then a
# `nix shell nixpkgs#<tool>` away in-pane. Override PER-ENV with
# `[env.<name>.sandbox] devshell = "..."` (e.g. give sprites the lean "sprite-full"
# while a bigger VPS env keeps the full default).
# devshell = "sandbox"
# Tier B: bind-mount the host Nix daemon socket into the sandbox so full
# `nix develop`/`build`/`fmt` run INSIDE it. `true` forces it on for every
# sandbox. `false` (default) does NOT fully disable it: as a backstop it is
# auto-enabled for a local flake-backed worktree, so an in-sandbox `nix-direnv`
# cache MISS re-evals via the daemon instead of dying on the read-only
# `/nix/store`. The socket is a local unix socket, so this is compatible with
# `network = none`. To suppress the auto-backstop, set `warm_direnv = off` or
# use a `sealed` profile. Ignored if the host has no Nix daemon.
nix_daemon = false

# ── Missing backend behaviour ─────────────────────────────────────────────────
# What to do when no backend in backend_chain is available:
#   warn   — open the pane on the host and show a banner (default).
#   prompt — ask before falling back to host.
#   fail   — refuse to open the pane.
on_missing = "warn"

# ── Failover when the SELECTED environment can't be brought up ─────────────────
# Distinct from on_missing (which governs only the local Auto backend chain).
# When a *named* [env.<name>] or an explicit non-local placement (provider/k8s/
# ssh) fails to come up — e.g. a managed provider rejects the token / hits its
# machine limit, or a pod won't schedule — what should thegn do?
#   "halt" — (default) HALT that worktree's pane and show a warning modal with
#            the real cause + a retry. A remote/managed env is often required for
#            correctness or safety, so a silent drop to the host is refused.
#   "ask"  — block and PROMPT: a modal shows the real failure cause and lets you
#            [r] retry bring-up or [h] run on the host for now. The honest middle
#            ground — you always know when you're NOT on the env you picked.
#   "auto" — walk backend_chain down to the host on failure, silently (the
#            worktree is still marked degraded in the sidebar). Historical
#            `failover = true` behavior.
# Legacy booleans still parse: true ⇒ "auto", false ⇒ "halt".
# Override per environment with `[env.<name>] failover = "halt"|"ask"|"auto"`.
failover = "halt"

# Drive the OCI runtime against a REMOTE daemon instead of SSH-wrapping the whole
# backend argv (an alternative reach to `[env.<name>] placement = "ssh"`, for when
# the container daemon — not just the shell — lives on another box). Empty = local.
#   podman — a connection URL ("ssh://user@host/run/user/1000/podman/podman.sock")
#            injected as `--url`, or a configured connection name as `--connection`.
#   docker — a host ("ssh://user@host") injected as `docker -H`.
# Applies to create/inspect/exec/teardown alike. (Local backend detection still
# probes the local host; set this only when you know the remote daemon is up.)
oci_host = ""

# OCI runtime to run worktree containers under (`podman/docker --runtime <value>`).
# Empty = the daemon default (runc/crun) — a shared-kernel container. Set a stronger
# boundary when running untrusted code (only applies to OCI backends; non-OCI backends
# ignore it, and an unavailable runtime warns + falls back to the default):
#   "runsc" — gVisor: a userspace application kernel services the container's syscalls
#             (no /dev/kvm needed). Reported as isolation class `userspace-kernel`.
#   "krun"  — libkrun: the container runs inside a hardware-virtualized microVM
#             (needs /dev/kvm). Reported as isolation class `guest-kernel`.
# The worktree bind stays path-preserving either way, so host-side git keeps working.
# `thegn doctor` reports the resolved isolation class.
oci_runtime = ""

# ── Personal environment layer ────────────────────────────────────────────────
# [sandbox.home] makes a sandbox/remote feel like LOCAL by reproducing *your*
# setup in it — independent of any repo. The PROJECT toolchain is derived
# automatically from the repo (flake.nix/devenv.nix/.envrc, .tool-versions,
# language manifests); this table is the generic, declarative PERSONAL layer on
# top. Applied to every provider/remote sandbox on first open, then checkpointed
# so it's one-time. Empty (the default) = nothing extra.
# [sandbox.home]
# # CLI tools installed in every sandbox. Nix-first (`nix profile install
# # nixpkgs#<tool>`, consistent names) when Nix is present, else a best-effort
# # native package manager (apt/apk/dnf). Bespoke installs go in `setup` below.
# tools = ["fd", "fzf", "atuin", "ripgrep"]
# # Host dotfiles (basenames under your $HOME) uploaded into the sandbox home.
# dotfiles = [".zshrc", ".gitconfig", ".tmux.conf"]
# # OR clone a dotfiles repo + run its install.sh/bootstrap.sh/setup.sh.
# dotfiles_repo = ""
# # Bring-your-own setup — inline commands run (in order) in every sandbox, e.g.
# # install an agent CLI or internal tooling that isn't a package.
# setup = []
# # OR a setup script (host path uploaded + run, or an in-sandbox path).
# setup_script = ""
# # Coding agents to make work out-of-the-box INSIDE the sandbox: known CLIs are
# # installed and every listed agent's host config/credentials are uploaded so
# # it's logged-in there (claude code, codex, or a custom one like hermes). NOTE:
# # this carries credentials into the remote VM — list only agents you trust there.
# agents = ["claude", "codex"]
# # Host services exposed INSIDE the sandbox via a reverse tunnel (over the
# # resident bridge) so an in-sandbox process/agent reaching 127.0.0.1:<port> hits
# # the HOST's service — a host localhost DB/API, or a host-bound MCP server.
# # Specs: "5432" (same port), "8080:5432" (host loopback port), "8080:db.lan:5432".
# reverse_forwards = ["5432", "11434"]
# # Opt-in (default false): carry your atuin shell-history credentials + config into
# # every sandbox so its history joins your atuin sync (host <-> sprites, via atuin's
# # own auto_sync). Uploads the dereferenced ~/.config/atuin/config.toml + the
# # key/session under ~/.local/share/atuin; NOT the history DBs (the server syncs
# # those). No-op if atuin isn't installed / there's no host atuin config. Carries
# # credentials into the remote — enable only where you trust it.
# atuin = true
# # How hard to reproduce YOUR host shell here (a ladder, default "portable"):
# #   clean       — no personal dotfiles/tools; a plain rc-free shell. Bulletproof.
# #   portable    — install tools + portable dotfiles, but SKIP (with a warning) a
# #                 dotfile that hard-codes paths absent in the sandbox (e.g. a
# #                 home-manager ~/.zshrc full of /nix/store/… paths) rather than
# #                 shipping a broken shell. The safe default.
# #   tool-parity — portable, plus install tools your rc references but didn't list.
# #   host-parity — reproduce the host nix closure so your EXACT dotfiles work
# #                 unchanged (experimental). Heavy — meant for long-lived boxes,
# #                 set per-env (see [env.<name>] below). Transport, auto-selected:
# #                   • P2P (no infra): with connect="ssh" + no binary_cache_url,
# #                     the host store IS the cache — the closure (zsh + starship/
# #                     atuin/direnv/fzf + what your rc sources) is pushed straight
# #                     into the sandbox over the WSS ssh tunnel (nix copy --to
# #                     ssh-ng://), then `nix profile install`ed onto PATH. No hosted
# #                     cache, no signing key. (Re)create the sandbox with
# #                     connect="ssh" first.
# #                   • Hosted cache: set [env.<name>.provider] binary_cache_* and
# #                     the host pushes there; the sandbox substitutes from it.
# #                   • home-manager: else set nix_home_flake (below).
# strategy = "portable"
# # When true (default), under portable/tool-parity a dotfile that references absent
# # store paths is skipped+warned instead of uploaded broken. false = upload anyway.
# portable_dotfiles_only = true
# # host-parity fallback: your home-manager flake for an in-sandbox `home-manager
# # switch` when no binary cache is available (the cache-first closure copy reuses
# # [env.<name>.provider] binary_cache_*). Empty = disabled.
# nix_home_flake = ""

# The personal layer is per-env overridable: keep a safe global default, but ask
# for full parity on a long-lived box and a clean shell on an ephemeral sprite.
# [env.bigbox.sandbox.home]
# strategy = "host-parity"
# [env.sprite.sandbox.home]
# strategy = "clean"

# ── Resource limits (cross-backend) ───────────────────────────────────────────
# Cap CPU/memory for worktree panes so heavy work (a big `cargo build`) can't
# peg the machine. Enforced on every backend:
#   • OCI (podman/docker) — per-container `--cpus` / `--memory`.
#   • bwrap / systemd / none — a systemd user-scope `CPUQuota` (cgroup v2). When
#     the host lacks cgroup `cpu` delegation, thegn falls back to a soft `nice`
#     (priority only, not a hard cap); `thegn doctor` shows which is in effect.
#
#   cpu       — PER-PANE ceiling, fractional cores: "0.5" = half a core, "2" = two.
#   memory    — per-pane memory: "512m", "2g".
#   cpu_total — AGGREGATE ceiling across ALL panes combined, in cores. Every pane
#               joins a shared `thegn.slice` bounded by this. Default "auto" =
#               leave 2 cores free (ncpu − 2). Set "off" (or "") to disable, or a
#               number ("6") for an explicit aggregate. Applied to host-toolchain
#               backends (bwrap/systemd/none); remote/OCI aggregate is not yet
#               wired (per-pane `cpu`/`memory` still apply remotely via OCI).
[sandbox.limits]
# cpu       = "2"
# memory    = "4g"
# cpu_total = "auto"

# ── Named volumes (OCI only) ──────────────────────────────────────────────────
# Persistent volumes that survive container recreations.
# Key = volume name (created by podman/docker if absent), value = mount point
# inside the container. Useful for package caches that shouldn't cold-start
# on every `just build`.
# [sandbox.volumes]
# cargo-registry = "/root/.cargo/registry"
# node-modules   = "/root/.npm"
# pip-cache      = "/root/.cache/pip"

# ── Remote transport tuning ───────────────────────────────────────────────────
# Hardening for EVERY control-plane ssh connection (host bring-up, remote git
# reads, delivery, probes) against flaky links: keepalives detect a dead path
# in ~interval×count seconds; transient failures (ssh exit 255, timeouts)
# retry with exponential backoff instead of failing the host; a host that
# still lands on Failed is re-probed in the background on `heal_backoff_secs`
# until it recovers (stuck worktree splashes then resume on their own).
# Resolved once at startup (like the theme); a change needs a restart.
[remote]
# keepalive_interval_secs = 15   # ssh ServerAliveInterval (0 = off)
# keepalive_count_max = 4        # ssh ServerAliveCountMax (~60s to declare dead)
# connect_timeout_secs = 10      # ssh ConnectTimeout
# control_persist_secs = 300     # idle ControlMaster lifetime
# tcp_keepalive = true           # kernel-level probes alongside ServerAlive
# retry_attempts = 4             # transient retries per bring-up step
# retry_base_delay_ms = 1000     # first backoff; doubles per attempt…
# retry_max_delay_ms = 15000     # …capped here
# heal_backoff_secs = [15, 30, 60, 300]  # failed-host re-probe cadence (last repeats)

# ── Offline detection ─────────────────────────────────────────────────────────
# thegn auto-detects when the network is unreachable and pauses remote features
# (GitHub PR/CI/issue refreshes, network-acquired MCP servers) rather than
# hammering unreachable endpoints. Local git/DB caches are served stale. It
# restores automatically the moment a network call succeeds.
[network]
# mode:
#   auto    — passive detection (default): flip offline after repeated failures,
#             restore on the next success.
#   online  — never auto-disable (opt out of detection).
#   offline — force airplane mode: skip all remote refreshes + network MCPs.
# mode = "auto"
# offline_after_failures = 3   # consecutive failures before concluding offline
# recovery_probe_secs = 30     # while offline, re-probe at most this often

# ── Remote worktrees ──────────────────────────────────────────────────────────
# Run worktrees on a remote machine over SSH. Leave host empty for local use.
# Control-plane operations (git reads, container lifecycle) always use ssh;
# the interactive pane uses mosh (resilient to network changes) by default.
[sandbox.remote]
# Remote host. Accepts "user@host", bare hostname (uses $USER), or an SSH
# alias from ~/.ssh/config. Empty = local only (default).
host = ""
port = 22
# mosh — UDP tunnel; survives IP changes and flaky connections. Requires the
#         mosh package on both the local machine and the remote host.
# ssh  — plain SSH pty; works everywhere but drops on network interruption.
transport = "mosh"
# remote     — worktrees live on the remote host under remote_dir (default).
# sshfs      — worktrees are sshfs-mounted locally; slower but local toolchain.
# local_exec — experimental: agent runs locally against the remote filesystem.
mode = "remote"
# Where worktrees are stored on the remote host.
remote_dir = "~/thegn-worktrees"
# Forward the local SSH agent (ssh -A) so git push uses your local keys.
# Disable if the remote host has its own deploy key.
forward_agent = true

# ── Per-sandbox VPN / tunnel ──────────────────────────────────────────────────
# Attach a worktree's sandbox to its OWN overlay network / tunnel, with its own
# identity, leaving the host's networking (including any host tailscaled)
# completely untouched. Off by default (provider = "none").
#
# How it works: thegn runs the tunnel daemon as a per-worktree *sidecar* (it
# never embeds a tunnel datapath in-process, and never touches your host VPN).
# In the default `sidecar` mode the worktree container joins the sidecar's
# network namespace, so its ONLY egress is the tunnel and its own capabilities
# stay untouched (NET_ADMIN / /dev/net/tun live in the sidecar, not the
# worktree). Bring-up runs off the event loop with a bounded readiness wait.
[sandbox.vpn]
# Provider: none | tailscale | headscale | wireguard | openvpn | netbird |
#           zerotier | custom. `headscale` is `tailscale` pointed at a
#           self-hosted control server (set tailscale.login_server below).
provider = "none"
# Attach mode:
#   sidecar      — companion container owns the netns; worktree joins via
#                  `--network container:<sidecar>` (default; best isolation).
#   proxy        — userspace tunnel exposes a SOCKS5/HTTP proxy; only proxy-aware
#                  traffic is tunneled (not a containment boundary). The only
#                  honest option for the bwrap/systemd backends.
#   in_container — run the VPN client inside the worktree container itself
#                  (needs NET_ADMIN + /dev/net/tun; weakens `hardened`).
#   netns        — join a host-prepared named netns (host-toolchain; best-effort).
mode = "sidecar"
# Override the provider's default sidecar image. Empty = provider default.
sidecar_image = ""
# Seconds to wait for the tunnel to come up before applying on_error.
ready_timeout_secs = 30
# When the tunnel can't come up:
#   fail    — refuse to launch (don't fall back to a less-isolated network).
#   warn    — launch with the tunnel down (loud warning).
#   offline — force network=none so nothing leaks onto the host network.
on_error = "fail"
# DNS composition:
#   tunnel       — the overlay owns resolution (MagicDNS / pushed DNS); the
#                  network_allow/network_block filter is bypassed (default).
#   filter-front — chain the allow/block DNS filter in front of the tunnel's
#                  resolver (preserves auditing). NOTE: with a sidecar tunnel the
#                  filter can't yet reach the sidecar's netns, so this currently
#                  behaves like `tunnel`; the resolver-chaining seam exists.
#   filter-only  — ignore the overlay's pushed DNS, keep the filter only.
dns = "tunnel"
# Request an ephemeral node identity where supported (Tailscale/Headscale/
# NetBird) so the device auto-deregisters from the control plane on teardown.
ephemeral = true
#
# Tip: pair `provider` with the `sealed-tunnel` (alias `tunnel-only`) hardening
# profile for a worktree that is fully cap-dropped AND has no host egress — its
# only route is the tunnel. Plain `sealed` refuses a VPN (network=none).
#
# Secrets: auth keys / configs accept a secrets-ref so they never sit in plain
# text here — "env:VAR_NAME" reads an env var, "file:~/path" reads a file. The
# resolved secret is injected into the *sidecar* only, never the worktree, so a
# coding agent in the worktree can't read it.

# [sandbox.vpn.tailscale]   # provider = "tailscale" or "headscale"
# auth_key = "env:TS_AUTHKEY"   # prefer an ephemeral, pre-authorized, tagged key
# login_server = ""             # set to your Headscale URL for provider="headscale"
# tags = ["tag:dev"]            # ACL tags advertised by this node
# exit_node = ""                # route egress through this exit node
# accept_routes = false         # accept subnet routes from the tailnet
# hostname = ""                 # node name (default: derived from container name)
# advertise_routes = []         # CIDRs to advertise as subnet routes
# extra_args = []               # extra `tailscale up` flags

# [sandbox.vpn.wireguard]   # provider = "wireguard"
# config_path = "/etc/wireguard/wg0.conf"   # a wg-quick .conf, OR:
# config = "file:~/wg/dev.conf"             # inline body via a secrets-ref

# [sandbox.vpn.openvpn]     # provider = "openvpn"
# config_path = "~/ovpn/dev.ovpn"
# auth_user_pass = "file:~/ovpn/creds"      # "user\npass"
# extra_args = []

# [sandbox.vpn.netbird]     # provider = "netbird"
# setup_key = "env:NB_SETUP_KEY"
# management_url = ""                        # self-hosted control plane
# hostname = ""

# [sandbox.vpn.zerotier]    # provider = "zerotier"
# network_id = ""                            # 16-hex network id
# controller_url = ""                        # self-hosted controller/moon
# api_token = "env:ZT_API_TOKEN"             # to auto-authorize the member

# [sandbox.vpn.custom]      # provider = "custom" — escape hatch for any tunnel
# up = "..."                                 # establishes the tunnel
# down = "..."                               # tears it down
# ready_check = "..."                        # exit-0 means ready (polled)
# image = ""                                 # sidecar image (mode=sidecar)
# {name}, {netns}, {worktree} expand in the commands above.
# [sandbox.vpn.custom.env]
# FOO = "bar"

# ── Ingress sharing (`[share]`) ─────────────────────────────────────────────
# The INBOUND sibling of [sandbox.vpn]. Where the VPN block gives a worktree
# *egress* through an overlay, [share] exposes a service running *inside* a
# worktree (a dev server, a PR preview, a webhook/OAuth callback) to the outside.
# Provider-pluggable; pick the one that matches your reach:
#   bore      — instant raw-TCP public URL, zero infra (the no-account default)
#   frp       — self-hosted public HTTPS + subdomains (+ TCP/UDP): demos/webhooks
#   tailscale — private to your tailnet (`serve`) or public (`funnel`); reuses
#               the worktree's [sandbox.vpn] tailscale tunnel — NO new auth
#   iroh      — peer-to-peer (dumbpipe): a teammate connects with a ticket; never
#               touches the public web, NAT-traversing
# Disabled by default. Open one with `thegn share start <port>` or Alt+Shift+S.
[share]
provider = "none"   # none | bore | frp | tailscale | iroh
# Requested reach: public | private. Authoritative only where the backend can do
# both (tailscale serve vs funnel); bore/frp are public-only (private downgrades
# with a warning), iroh is always peer-private.
visibility = "public"
# Safety guard: when false, refuse any share reachable from the PUBLIC INTERNET
# (frp http(s), tailscale funnel). Private/team/peer shares are unaffected. The
# statusbar badge renders AMBER while a worktree is publicly exposed.
allow_public = true
# Intent-first reach → provider mapping. When ≥2 of these are set, Alt+Shift+S
# offers a "Share to…" picker (🌐 public / 👥 team / 🔗 peer) instead of using the
# single `provider` above; pick *who* should reach it and the provider is chosen
# for you. Each defaults to "none" (no picker). Recommended:
# public = "frp"        # internet, browser-reachable
# team   = "tailscale"  # your tailnet / a teammate
# peer   = "iroh"       # hand a teammate a ticket
# When the share can't come up: fail (surface the error) | warn (note and skip).
on_error = "fail"
# Seconds to wait for the URL to appear before applying on_error.
ready_timeout_secs = 20

# [share.bore]   # provider = "bore" — https://github.com/ekzhang/bore
# to = ""                       # relay host running `bore server`; "" = bore.pub
# secret = "env:BORE_SECRET"    # shared HMAC (secrets-ref); must match the server
# remote_port = 0               # port to bind on the relay; 0 = relay chooses
# local_host = "127.0.0.1"      # interface the dev server listens on
# extra_args = []               # extra `bore local` flags

# [share.frp]    # provider = "frp" — https://github.com/fatedier/frp (self-host)
# server_addr = "frps.example.com"   # your frps host (required)
# server_port = 7000                 # frps control port
# token = "env:FRP_TOKEN"            # shared token (secrets-ref); matches frps
# proxy_type = "https"               # https | http | tcp | udp
# subdomain_host = "share.example.com"  # the server's subDomainHost (for the URL)
# subdomain = ""                     # "" = a stable per-worktree slug <name>-<port>
# remote_port = 0                    # tcp/udp only; 0 = server chooses
# vhost_https_port = 443             # server HTTPS vhost port (for the URL suffix)
# extra = []                         # extra frpc.toml lines (appended to [[proxies]])

# [share.tailscale]   # provider = "tailscale" — needs [sandbox.vpn] = tailscale
# funnel = false       # false = `tailscale serve` (tailnet-only); true = public
# https_port = 443     # serve/funnel HTTPS port (funnel: 443/8443/10000 only)

# [share.iroh]    # provider = "iroh" — https://github.com/n0-computer/dumbpipe
# extra_args = []  # extra `dumbpipe listen-tcp` flags (e.g. a self-hosted relay).
#                  # The consumer connects with `dumbpipe connect-tcp <ticket>`.

# ── Automatic port forwarding / browser preview (`[forward]`) ───────────────
# The outbound-localhost sibling of [share]: when a dev server binds a port INSIDE
# a worktree's sandbox (container / ssh host / k8s pod), thegn auto-detects it
# and forwards it to the host so it's previewable at http://localhost:<port>.
# Active forwards appear in the System panel; press `o` to open the focused one in
# your browser. On by default — forwards bind loopback only, so this is safe.
[forward]
auto = true            # auto-detect + forward newly-bound sandbox ports
range = "8000-8999"    # host-port range for remaps when a port's own number is taken
ignore = []            # container ports never to forward, e.g. [5432, 22]
only = []              # if non-empty, ONLY forward these container ports
bind = "127.0.0.1"     # host interface to bind forwards on (loopback = host-local)
poll_secs = 2          # how often the sandbox is scanned for new listening ports
browser = ""           # "open in browser" command; "" = $BROWSER, then xdg-open/open
open_on_detect = false # auto-open the browser when a new forward comes up
# Conflict handling: if a detected port's own number is already bound on the host,
# the forward is remapped to the next free port in `range` and a notification shows
# the real URL (e.g. "port 3000 in use → forwarded at localhost:8001").

# ── Named execution environments (`[env.<name>]`) ───────────────────────────
# A reusable *library* of execution environments. Each bundles three orthogonal
# axes: a PLACEMENT (where processes run — local / ssh / k8s / provider), an
# isolation OVERLAY on top of `[sandbox]` (`[env.<name>.sandbox]`), and a DATA
# mode (where the worktree files live). A workspace/repo/worktree then selects
# one by name. Selection precedence (most specific wins):
#   worktree `env_name` (DB) → workspace `env_name` (DB) → repo `.thegn.*`
#   `env = "…"` → global `default_env` (below) → the implicit `"default"`.
# The `"default"` env is this `[sandbox]` + `[sandbox.remote]` block — so with
# no `[env.*]` defined, nothing changes. Manage selections with `thegn env`.
#
# Pick the default env for every worktree that hasn't chosen one (empty ⇒
# "default"). Lives under `[sandbox]`; shown here for context.
# default_env = ""
#
# Example 1 — custom local containers (a pinned image, sealed hardening):
# [env.local-containers]
# placement = "local"
# [env.local-containers.sandbox]
# backend = "podman"
# image = "registry.example.com/dev:latest"
# profile = "sealed"
#
# Example 2 — a company Kubernetes cluster (exec into a pod via kubectl):
# [env.company-k8s]
# placement = "k8s"
# data = "in_env"            # files live in the pod
# [env.company-k8s.sandbox]
# backend = "none"           # the pod IS the isolation boundary
# [env.company-k8s.k8s]
# kubectl = ""               # kubectl binary (empty ⇒ `kubectl` on PATH)
# context = "company-prod"
# namespace = "dev-blake"
# pod = "sz-dev"             # target pod name (exec'd into)
# container = ""             # optional `-c <container>`
# pod_template = "~/.sz/dev-pod.yaml"   # `thegn env up` applies this (spawn custom env)
# image = "registry.example.com/dev:latest"  # OR template-less `kubectl run`
# remote_access = true       # `thegn env forward 8080:80` (kubectl port-forward)
# # `thegn env up` spawns the pod + waits Ready; `env down` deletes it.
#
# Example 3 — a hosted agent sandbox provider (e.g. Daytona). Two modes:
# (a) static/CLI — `exec_command` is an argv template, `{id}` → the sandbox id:
# [env.datonya]
# placement = "provider"
# [env.datonya.provider]
# provider = "daytona"
# id = "sb-1234"
# exec_command = ["daytona", "ssh", "{id}", "--"]
# up_command = ["daytona", "create", "--id", "{id}"]   # run by `thegn env up`
# down_command = ["daytona", "delete", "{id}"]         # run by `thegn env down`
# # (b) API — `thegn env provision` creates a sandbox over Daytona's REST API
# # (then set `id` to attach); `thegn env deprovision <id>` destroys it:
# # api_base = "https://app.daytona.io/api"
# # api_key_env = "DAYTONA_API_KEY"    # env var holding the Bearer token
# # template = "debian:stable"         # snapshot/image to create from
#
# Example 4 — a remote box over ssh/mosh with a dedicated ssh config + bastion:
# [env.gpu-box]
# placement = "ssh"
# data = "in_env"            # in_env (files on the remote) | sshfs | sync | local_exec
# failover = "halt"          # per-env override of [sandbox] failover:
#                            #   "halt" | "ask" (prompt) | "auto" (silent host drop)
# placement_mode = "auto"    # placement-engine class for this env (auto | packed |
#                            #   dedicated); omit ⇒ inherit [placement] mode
# [env.gpu-box.resources]    # declared ask the placement engine RESERVES (falls
# cpu = "2"                  #   back per-field to [placement.default_resources])
# memory = "4g"
# cpu_max = "4"              # optional container limits: feed --cpus/--memory when
# memory_max = "8g"          #   the resolved sandbox declares none of its own
# [env.gpu-box.ssh]
# host = "user@gpu-box"      # empty ⇒ inherit the worktree's own target / [sandbox.remote]
# port = 22
# transport = "mosh"         # mosh | ssh
# forward_agent = true
# ssh_config = "~/.ssh/work.config"   # ssh -F
# jump_host = "bastion.example.com"   # ssh -J
# identity = "~/.ssh/id_work"         # ssh -i
# extra_args = []
# # data = "sshfs" FUSE-mounts [sandbox.remote] remote_dir at
# # <thegn-dir>/mounts/<host-slug>; data = "sync" keeps a local working copy
# # there, kept coherent with the remote via an rsync delta. BOTH now mount/sync
# # AUTOMATICALLY on pane spawn and unmount/push on close (no manual `env up`),
# # and run the pane LOCALLY at the mountpoint. `thegn env up/down` still works
# # for an explicit one-off. Intended with `backend = "none"`/host.
#
# ── [host.<name>] — machines as first-class resources ────────────────────────
# A host is a machine that can run OCI containers, provisioned ONCE (connect →
# probe podman/docker → optionally install it with consent → deliver the baked
# multi-arch base image by digest → seed warm /nix + cargo volumes → Ready) and
# then shared by EVERY env/worktree that lands on it — the 20-minute-class
# setup cost is paid per host, not per sandbox. `[env.<name>] host = "<name>"`
# binds an env to a host; several envs may share one. Hosts are GLOBAL config
# only (a repo .thegn.toml can select a host-backed env, never define a
# host). Inspect + drive with `thegn host list|status|provision|probe`.
#
# [host.gpu-box]
# reach = "ssh"                # ssh | iroh | cloud | local
# image = ""                   # base-image override (name[:tag][@sha256:…]);
#                              #   empty = your LOCAL sandbox base ([sandbox]
#                              #   image, else debian:stable), transferred to
#                              #   the host — so a plain [host.*] works OOTB.
#                              #   NOTE: a LOCAL sandbox inherits your dev
#                              #   toolchain by bind-mounting the host's /nix; a
#                              #   REMOTE host CAN'T (different machine). For a
#                              #   remote shell seeded with nix + your shell +
#                              #   agents (Claude Code) like a local sprite, use
#                              #   the baked toolchain image: build it with
#                              #   `nix build .#sandbox-image` and point either
#                              #   this key or [sandbox] image at it (delivery
#                              #   streams/builds it onto the host). A bare
#                              #   debian:stable base gives a toolchain-less
#                              #   container.
# install_runtime = "ask"      # never | ask | auto — consent for installing
#                              #   podman on the machine; NEVER silent. `ask`
#                              #   raises a confirm modal (or `host provision --yes`);
#                              #   the answer persists per host.
# delivery = []                # preference order: "ssh-stream" (registry-less
#                              #   resumable transfer, the default), "rsync",
#                              #   "registry", "skopeo", "build"; empty = auto
# volumes = ["nix-store", "cargo"]   # warm volumes seeded once and mounted into
#                              #   every sandbox; omit for both, [] for none
# probe_ttl_secs = 900         # Ready hosts re-verify (one cheap exec) after this
# capacity = { cpu = "8", memory = "16g" }  # declared machine size for the
#                              #   [placement] engine's capacity index; omitted =
#                              #   unknown size (dedicated placements only, never
#                              #   packed). Engine-created hosts get their spec
#                              #   from the autoscale template instead. For a
#                              #   user-owned host the probe caps this claim:
#                              #   ceiling = min(declared, probed) x overcommit
#                              #   x independent_safety_pct.
# trust_egress_enforced = false # ATTESTATION (taken on faith, never verified):
#                              #   this box enforces the posture a thegn-built
#                              #   image guarantees, restoring the one-notch
#                              #   trust drop unattested user-owned hosts get
#                              #   for packing (a probe proves PRESENCE of
#                              #   podman/userns, never ENFORCEMENT).
# [host.gpu-box.ssh]           # same knobs as [env.<name>.ssh]
# host = "user@gpu-box"
# port = 22
# transport = "ssh"            # the host control plane always uses plain ssh
# forward_agent = true
# ssh_config = "~/.ssh/work.config"   # ssh -F
# jump_host = ""               # ssh -J bastion
# identity = "~/.ssh/id_work"  # ssh -i
# extra_args = []
#
# # A NAT'd machine over an iroh (dumbpipe) tunnel: run
# #   dumbpipe listen-tcp --host 127.0.0.1:22
# # on it once and paste the ticket (env:/file: secret refs supported).
# [host.nat-laptop]
# reach = "iroh"
# [host.nat-laptop.iroh]
# ticket = "env:TG_LAPTOP_TICKET"
# ssh_port = 22
# user = "me"
#
# # An idle Windows box (on your tailnet, running Docker) as a worktree host.
# # thegn's remote path is POSIX (/bin/sh, git, dtach, …), so point the ssh
# # endpoint at a WSL2 distro — a real Linux shell with the Windows Docker
# # daemon exposed (Docker Desktop WSL integration, or docker-ce inside WSL).
# # Two entry methods, same landing: run sshd INSIDE the distro, or set the
# # Windows OpenSSH server's DefaultShell to C:\Windows\System32\wsl.exe so a
# # session drops straight into Linux. Use the Tailscale MagicDNS name as host.
# # install_runtime = "never" (Docker is already there — do not install podman);
# # the bound env sets backend = "docker" so the container runs on that daemon.
# # Worktrees live under ~/thegn-worktrees in the WSL FS — NOT /mnt/c (a git
# # worktree needs a real Linux filesystem for symlinks/inodes/perf).
# [host.win1]
# reach = "ssh"
# install_runtime = "never"
# capacity = { cpu = "8", memory = "16g" }   # omit for manual (pinned) placement
# [host.win1.ssh]
# host = "me@win1"             # Tailscale MagicDNS name
# transport = "mosh"           # or "ssh"; mosh survives the box napping (apt install mosh dtach)
# forward_agent = true         # remote `git push` uses your local keys
# [env.win1]                   # MANUAL: pin an env per box, pick it at worktree-create
# placement = "ssh"
# host = "win1"
# [env.win1.sandbox]
# backend = "docker"
# # AUTO-SPREAD across win1/win2 instead: give each [host.*] a capacity, enable
# # [placement] (mode = "packed", pack_strategy = "spread"), and leave an env
# # UNPINNED (no `host =`) so the broker chooses — see the [placement] section.
#
# # Bind envs to hosts: both of these pay gpu-box's setup once, share its
# # digest-pinned image + warm volumes, and spawn sandboxes near-instantly.
# [env.gpu]
# placement = "ssh"
# host = "gpu-box"
# [env.gpu-heavy]
# placement = "ssh"
# host = "gpu-box"
#
# # A provider-managed host (the cloud lowering: "provisioning" registers the
# # base image as the provider's bootable template/snapshot):
# [host.sprites-us]
# reach = "cloud"
# [host.sprites-us.cloud]
# provider = "sprites"         # sprites | daytona
# api_base = ""                # empty = the provider's default endpoint
# api_key_env = "SPRITES_TOKEN"   # env var holding the API token
# template = "thegn-base"   # template/snapshot the base image registers under
#
# Example 5 — a managed sandbox provider: Sprites (sprites.dev, Firecracker
# microVMs with a persistent fs + ~300ms checkpoints). One-time setup:
#   1. Generate a token at sprites.dev/account; export it (the REST API and the
#      `sprite` CLI both read it):  export SPRITES_TOKEN="my-org/token-id/secret"
#   2. Install + auth the CLI (used for the pane exec bridge):
#        curl -fsSL https://sprites.dev/install.sh | sh
#        sprite auth setup --token "$SPRITES_TOKEN"
#   3. Create the sprite once:  thegn env provider create --env sprites
#      (or `sprite create my-worktree`), then set `id` below to its name.
# [env.sprites]
# placement = "provider"
# data = "in_env"            # in_env: work in the sprite's persistent fs (default)
#                            # sync:   push the local worktree into the sprite on
#                            #         pane spawn, pull changes back on close.
# #                          # FULL LOCAL PARITY (in_env): a fresh sprite clones
# #                          # origin AND replays your local state on top —
# #                          # unpushed commits (a thin git bundle), uncommitted
# #                          # tracked changes (git diff HEAD), and untracked
# #                          # non-ignored files — so the sprite matches your
# #                          # working tree, not just origin. Automatic + best-
# #                          # effort (a capture/replay failure leaves the pristine
# #                          # origin checkout). Runs once on first provision (and
# #                          # on a warm-pool claim); re-opens reuse the fs.
# [env.sprites.provider]
# provider = "sprites"       # selects the SpritesProvider REST adapter
# id = "{repo}-{worktree}-{hash}"   # sprite name; tokens give a PER-WORKTREE sprite.
#                            #   {repo}=repo dir name, {worktree}=worktree dir basename
#                            #   (the branch slug), {hash}=stable digest of the full
#                            #   worktree path (the collision-defuser: two same-named
#                            #   branches in different repos still differ), {slug}=full
#                            #   path. Empty ⇒ this default (conflict-free across repos,
#                            #   org-wide). A literal with no token = one SHARED sprite.
#                            #   Clamped to a DNS-safe length, keeping the hash suffix.
# api_key_env = "SPRITES_TOKEN"        # empty ⇒ defaults to SPRITES_TOKEN
# # api_base = "https://api.sprites.dev/v1"   # empty ⇒ this default
# # workdir = "/workspace"   # data = "sync" pushes/pulls the worktree here
# # auto_provision = false   # create the sprite on first open if missing (8-E
# #                          #   warm-on-open) — over the REST API, so creation is
# #                          #   CLI-free (no `up_command`). Off by default —
# #                          #   creating a paid sandbox is opt-in. (The
# #                          #   `backend=sprites` launcher scaffolds it `true`.)
# # auto_checkpoint = false  # checkpoint the sprite on worktree close (suspend-on-
# #                          #   close, fast resume) — over the API, CLI-free. Off
# #                          #   by default (storage cost). Launcher scaffolds `true`.
# # --- provisioning speedups (make the one-time nix install + devShell faster) ---
# # nix_installer = "official"      # "official" (nixos.org --no-daemon, default +
# #                                 #   fallback) or "determinate" (faster Rust
# #                                 #   installer; falls back to official on failure)
# # nix_parallel_downloads = 0      # >0 sets http-connections + max-substitution-jobs
# #                                 #   (clamped 1..=256, e.g. 100) so the devShell's
# #                                 #   deps download in parallel — the biggest win
# # binary_cache_url = ""           # extra Nix substituter so the devShell is a
# # binary_cache_key = ""           #   download not a build (needs the public key)
# # binary_cache_push = false       # push the built devShell closure to the cache
# #                                 #   during provisioning (needs a signing key).
# #                                 #   ALSO used by [sandbox.home] strategy =
# #                                 #   "host-parity": the host pushes your dotfiles'
# #                                 #   /nix/store closure here so the sandbox
# #                                 #   substitutes it (pure-nixpkgs paths need no
# #                                 #   push — they come from cache.nixos.org). The
# #                                 #   sandbox must have EGRESS to the cache host
# #                                 #   (allow it in [sandbox] network_allow if the
# #                                 #   env filters egress).
# # host_cache = false              # Serve your HOST /nix/store as a LIVE binary cache
# #                                 #   (substituter) reachable from the sprite over the
# #                                 #   reverse tunnel, so in-sprite `nix develop`/`direnv`
# #                                 #   SUBSTITUTE prebuilt store paths from your host
# #                                 #   instead of building from source. A general cache
# #                                 #   over the WHOLE host store — strictly more capable
# #                                 #   than push_devshell's one-shot devShell upload,
# #                                 #   which it SUPERSEDES when set. Unsigned + loopback-
# #                                 #   tunnel-only (require-sigs=false in the sprite). The
# #                                 #   host serves it from the thegn process; needs a
# #                                 #   resident-bridge provider (sprites). Recommended.
# # push_devshell = false           # Use your HOST as the devShell cache (nix users).
# #                                 #   Seeds the repo's closure — ALREADY BUILT on your
# #                                 #   host (you run `nix develop`/direnv locally) —
# #                                 #   into the sandbox store. SCOPED: uploads only the
# #                                 #   paths public caches lack (the repo's from-source
# #                                 #   builds + rust-overlay output) via a file:// cache
# #                                 #   + the fs API; the sandbox fills the rest from
# #                                 #   cache.nixos.org → a local store hit, not a
# #                                 #   minutes-long from-source compile. No hosted
# #                                 #   cache/signing key needed; the host IS the cache.
# #                                 #   No-op without a nix devShell. Best-effort.
# #                                 #   (host_cache above supersedes this when both set.)
# # skip_devshell_warm = false      # skip the blocking devShell BUILD during
# #                                 #   provisioning. The repo's devShell then builds
# #                                 #   lazily in-pane on first `direnv`/`nix develop`
# #                                 #   instead of gating the loading screen on a
# #                                 #   multi-minute toolchain build → the shell comes
# #                                 #   up immediately. Trades a prebuilt (checkpointed)
# #                                 #   devShell for instant launch. No-op without nix.
# # connect = "exec"         # how the pane CONNECTS: "exec" (native WSS PTY relay,
# #                          #   default) or "ssh" (run sshd in the sandbox and attach
# #                          #   a local `ssh` client over the provider's TCP-over-WS
# #                          #   proxy — unlocks scp/sshfs/agent forwarding)
# # exec = "auto"            # how the interactive pane attaches:
# #                          #   auto — native API exec (PTY-over-WebSocket, NO
# #                          #          `sprite` CLI) when the provider supports it
# #                          #          (Sprites does), else the CLI. The default.
# #                          #   api  — force native API exec (error if unsupported).
# #                          #   cli  — always use the `*_command` CLI bridge below.
# #                          # Native exec also persists its session id, so a restart
# #                          # reattaches the live sprite session and replays scrollback.
# # The CLI bridge (used for exec = "cli", and as the auto fallback). PTY-capable:
# exec_command = ["sprite", "exec", "-s", "{id}", "--"]
# interactive_command = ["sprite", "exec", "-s", "{id}", "--tty", "--"]
# up_command = ["sprite", "create", "{id}", "--skip-console"]
# down_command = ["sprite", "destroy", "-s", "{id}", "--force"]
# # Wired axes (capability-gated, generic across providers):
# #  • EGRESS — [sandbox] network_allow/network_block are lowered to the sprite's
# #    DNS policy (POST /policy/network {rules:[{domain,action}]}) automatically
# #    on `thegn env provider create`.
# #  • SNAPSHOT — `thegn env snapshot [--label]` / `env snapshots` / `env restore <id>`
# #    (Sprites checkpoints).
# #  • FILE-SYNC — `data = "sync"` pushes the worktree into `workdir` on spawn and
# #    pulls it back on close (via the sprite /fs API; `.git` is skipped).
# #  • DATA PLANE — a provider worktree's git/diff/branches/files resolve INTO the
# #    sandbox (the chrome shows real state); a fresh sprite is repo-provisioned on
# #    open (clone for data=in_env, upload for data=sync).
# #  • RESIDENT BRIDGE — when a static-musl `thegn` is available (build:
# #    `nix build .#thegn-musl` or `just build-musl`; point THEGN_BRIDGE_BINARY
# #    at it), it's pushed into the sprite and run as `thegn bridge`, so git is
# #    fast (no per-op latency), file edits stream back live (fs.watch), activity
# #    dots reflect in-env CPU, and tests/jobs run in the sandbox.
# #  • NATIVE EXEC — with `exec = "auto"` (default) the interactive pane attaches
# #    over the Sprites WSS exec API directly (no `sprite` CLI), and reattaches its
# #    live session (replaying scrollback) across restarts. Set `exec = "cli"` to
# #    fall back to the `interactive_command` bridge.
# # FAILOVER — by default, if the sprite can't be brought up (bad/expired token,
# #   API down, quota), the worktree's pane HALTS with a warning modal (the real
# #   cause + a retry) rather than silently dropping to a host shell (see
# #   [sandbox] failover). Override per-env to prompt or auto-degrade instead:
# # failover = "ask"           # "halt" | "ask" (prompt: retry / run-on-host) | "auto"
#
# ── Example: a cheap commodity VPS (Hetzner Cloud) ─────────────────────────
# The budget alternative to a managed sandbox provider: thegn provisions a
# VPS via the vendor API, reaches it over plain ssh (a `thegn vps-ssh`
# self-bridge — no vendor CLI), and runs the same provisioning pipeline on it.
# THE COST MODEL DIFFERS FROM SPRITES: a VPS has no suspend/checkpoint — a
# powered-off instance still bills — so the only free state is DESTROYED.
# thegn therefore: never offers stop-on-idle (idle pool spares are
# destroyed, not suspended), ledgers every create before the API call, and
# runs a label-scoped reaper that destroys orphans/over-lifetime instances.
# Speed comes from a baked base image + (optionally) the warm pool:
#   cold, stock image   ~2-4 min  (create ~10s + nix install + repo steps)
#   cold, baked image   ~30-90 s  (`thegn env image-bake` → template below)
#   warm-pool claim     ~5 s      ([lifecycle.pool] size = 1; the spare bills
#                                  ~€4/mo while idle — the speed/budget knob)
#
#   1. Create an API token in the Hetzner Cloud console (project scope).
#   2. export HCLOUD_TOKEN=...
#   3. Optional but recommended: thegn env image-bake  → paste the template.
#
# [env.hetzner]
# placement = "provider"
# data = "in_env"              # the repo lives in the VPS (cloned from origin,
#                              #   local-parity overlay on open)
# [env.hetzner.provider]
# provider = "hetzner"
# # api_key_env = "HCLOUD_TOKEN"   # token env var (this is the default)
# # region = "fsn1"                # Hetzner location (fsn1/nbg1/hel1/ash/hil/sin)
# # size = "cx23"                  # server type (cx23 = 2 vCPU / 4 GB, ≈ €4/mo)
# # template = ""                  # image: "" ⇒ ubuntu-24.04 (docker + nix
# #                                #   prereqs installed via cloud-init on first
# #                                #   boot), or "snapshot:<id>" from image-bake
# # auto_provision = false         # create on first open (opt-in: real money)
# # max_instances = 5              # hard cap on concurrently-managed instances
# #                                #   (0 ⇒ this default) — the spend guardrail
# # max_lifetime_secs = 0          # destroy instances older than this (0 = off);
# #                                #   the hard ceiling for forgotten sandboxes
# # hibernate = "auto"             # snapshot-then-destroy when idle: auto (ON
# #                                #   for VPS — it bills while it exists) | on
# #                                #   | off. See [lifecycle] hibernate_after_secs
# #                                #   + [lifecycle.snapshot]
# # hibernate_idle_secs = 0        # per-env idle TTL override; 0 ⇒ the global
# #                                #   [lifecycle] hibernate_after_secs
# # nix_installer = "determinate"  # the faster installer is a good VPS default
# # The workload runs directly on the VPS by default (the VPS is the isolation
# # boundary, like a sprite). To containerize INSIDE it instead (docker is on
# # every image thegn boots):
# # [env.hetzner.sandbox]
# # backend = "docker"
# # NOT available on a VPS (no provider support): checkpoints/snapshot-restore
# # (`auto_checkpoint` is ignored; bake an image instead), native WSS exec
# # (`connect`/`exec` are ignored — attach is always the ssh self-bridge), and
# # egress translation (use an in-VPS backend's network controls).
#
# ── DigitalOcean (another commodity VPS — same model, cost, and caveats) ────
# Identical lifecycle to Hetzner (REST create → ssh self-bridge → ledger +
# reaper → image-bake; no checkpoints). Only the vendor knobs differ.
#   1. Create a personal access token in the DigitalOcean control panel
#      (API → Tokens, write scope).
#   2. export DIGITALOCEAN_TOKEN=...   (or point api_key_env at your own var,
#      e.g. DIGITALOCEAN_ACCESS_TOKEN that `doctl` uses)
#
# [env.digitalocean]
# placement = "provider"
# data = "in_env"
# [env.digitalocean.provider]
# provider = "digitalocean"
# # api_key_env = "DIGITALOCEAN_TOKEN"  # token env var (this is the default)
# # region = "nyc3"                     # DO region slug (nyc3/sfo3/ams3/fra1/…)
# # size = "s-1vcpu-2gb"                # Droplet size slug (≈ $18/mo; s-1vcpu-1gb
# #                                     #   is cheaper but tight for a nix build)
# # template = ""                       # image: "" ⇒ ubuntu-24-04-x64, or
# #                                     #   "snapshot:<id>" from `env image-bake`
# # auto_provision = false
# # max_instances = 5
# # max_lifetime_secs = 0
#
# ── Fly.io machines (CLI-free — no flyctl) ─────────────────────────────────
# A Fly machine is container-native (NOT a VPS): thegn drives the Machines
# REST API directly and reaches INTO the machine over a WireGuard tunnel to
# Fly's private 6PN network + `hallpass` ssh — the `fly ssh console` path,
# without the flyctl CLI. Unlike a VPS, a stopped machine is near-free, so it is
# treated as SCALE-TO-ZERO (idle spares park via stop/start instead of destroy).
#   1. Create a deploy/org token: `fly tokens create org` (or the dashboard).
#   2. export FLY_API_TOKEN=...
#
# thegn reaches the machine over ssh on a per-app dedicated IPv4 (~$2/mo,
# prorated, released when the sandbox is destroyed): each sandbox is its own Fly
# app, so destroy = delete the app (cascades the machine + IP).
#
# TWO speeds, via `template`:
#   - stock "" ⇒ ubuntu:24.04, and thegn installs sshd + prereqs at boot
#     (~40-90s cold — the convenient default).
#   - baked "image:<ref>" ⇒ boot STRAIGHT into a reachable shell with the whole
#     toolchain (nix + rust + just) already in the image — no per-VM install, the
#     fast path. Build + publish once: `just fly-image-publish registry=ghcr.io/you`
#     (nix/fly-sandbox-image.nix: sshd entrypoint + baked toolchain), then set the
#     printed template below. A stopped machine is scale-to-zero (rootfs-only cost).
#
# [env.fly]
# placement = "provider"
# data = "in_env"
# [env.fly.provider]
# provider = "fly"
# # api_key_env = "FLY_API_TOKEN"   # token env var (this is the default)
# # region = "iad"                  # Fly region (iad/lax/ams/syd/…)
# # size = "shared-cpu-2x"          # preset → guest cpu/memory (shared-cpu-1x…8x,
# #                                 #   performance-1x…4x)
# # template = ""                   # "" ⇒ ubuntu:24.04 (install sshd at boot), or
# #                                 #   "image:<ref>" to boot from the baked image
# #                                 #   (the fast path — see `just fly-image-publish`)
# # auto_provision = false
# # max_instances = 5
# # max_lifetime_secs = 0
# # Org defaults to "personal"; non-personal orgs are a follow-up config addition.
#
# ── machine0 VMs (MCP-native — NO `machine0` CLI binary) + NixOS ────────────
# machine0 (https://machine0.io) is a cloud-VM platform driven entirely through
# its remote MCP endpoint: thegn calls the MCP tools directly over HTTP
# (`vm_create`/`vm_list`/`vm_destroy`/`vm_suspend`, `image_*` snapshots,
# `ssh_key_*`, `sizes`) — no vendor CLI is installed. The interactive pane, exec,
# and file sync ride plain ssh with thegn's managed key (machine0's MCP `ssh_exec`
# is one-shot with no PTY, so a terminal must use real ssh — the VPS-shaped
# model), so a machine0 VM needs a reachable public address. A stopped VM
# `vm_suspend`s to a storage-only cost, so it is treated as SCALE-TO-ZERO (idle
# spares park via suspend/start, like Fly).
#
# NixOS is a first-class image: create with `template = "nixos-25-11-loaded"`,
# then thegn applies your flake with `nixos-rebuild switch --flake <ref>` over ssh
# (there is no provider tool for it) — see `provision_flake` below. Snapshots use
# `machine0 images` (checkpoint/restore recreates the VM from the saved image).
#   1. Create an API key in the machine0 dashboard (or `machine0 keys` if you use
#      the CLI elsewhere — thegn itself does not need it).
#   2. export MACHINE0_API_KEY=...
#
# [env.machine0]
# placement = "provider"
# data = "in_env"
# [env.machine0.provider]
# provider = "machine0"
# # api_key_env = "MACHINE0_API_KEY"      # x-api-key env var (this is the default)
# # api_base = "https://app.machine0.io/mcp"  # the MCP endpoint (empty ⇒ this default).
# #                                       #   USED (unlike the CLI providers) — thegn
# #                                       #   POSTs JSON-RPC tools/call here.
# # region = "us-east"                    # machine0 region (us-east/us-west/uk/eu/asia;
# #                                       #   required — no default)
# # template = ""                         # imageName at create. Empty ⇒ the default
# #                                       #   "nixos-25-11-loaded" (NixOS 25.11 + modern
# #                                       #   shell & dev tools). Or set any machine0 image
# #                                       #   (e.g. "ubuntu-24-04") or a checkpoint image name.
# # --- size: explicit OR dynamic multidimensional ---------------------------
# # size = "large"                        # explicit machine0 size (see `machine0 sizes`).
# #                                       #   Empty or "auto" ⇒ resolve the CHEAPEST size
# #                                       #   meeting the requirements below (default: "large").
# # min_vcpu = 0                          # dynamic-size floor: min vCPUs (0 ⇒ any)
# # min_ram_gb = 0                        # min RAM GiB (0 ⇒ any)
# # min_disk_gb = 0                       # min disk GiB (0 ⇒ any)
# # gpu = false                           # require a GPU size
# # nvme = false                          # require NVMe-backed local disk
# #                                       #   e.g. size="auto", min_vcpu=4, min_ram_gb=8,
# #                                       #   nvme=true ⇒ picks the cheapest xl-nvme-class box.
# # provision_flake = "./flake.nix#host"  # NixOS ONLY: applied post-create via
# #                                       #   `nixos-rebuild switch --flake <ref>` over
# #                                       #   ssh. A local path#attr is uploaded to the
# #                                       #   VM first; a flake URL (github:owner/repo#host)
# #                                       #   is used verbatim. Empty ⇒ no NixOS apply.
# # transport = "mosh"                    # interactive-pane transport: mosh (default —
# #                                       #   roaming/latency-resilient; auto-falls-back to
# #                                       #   ssh when the VM lacks mosh-server or its network
# #                                       #   blocks mosh UDP) | ssh. Control reads always ssh.
# # auto_provision = false                # create the VM on first open if missing
# # auto_checkpoint = false               # snapshot (machine0 images) on worktree close
# # max_instances = 5                     # hard cap on concurrently-managed VMs
# # max_lifetime_secs = 0                 # reaper ceiling (0 = off)
# # Wired axes: FILE-SYNC (`data = "sync"` over ssh), SNAPSHOT (`thegn env snapshot`
# # → machine0 images; restore recreates from the image), SCALE-TO-ZERO (idle
# # suspend). NOT available: native WSS exec / egress translation (the pane is ssh).
#
# ── Sandbox lifecycle: warm/suspend + budget ───────────────────────────────
# Budget-governed warm policy for managed-provider sandboxes (sprites/ssh/k8s).
# A provider sandbox only stays *running* while a live exec session into it exists
# (a pane or the resident bridge); idle ones suspend for free (filesystem kept).
# Defaults are budget-safe — thegn's own sidebar/activity polling never wakes a
# suspended sandbox, idle ones suspend after the TTL, and the few most-recently-
# used (plus any busy or pane-held) stay warm for instant resume. All optional.
[lifecycle]
# enabled = true              # master switch; off ⇒ inert (today's behavior)
# max_warm = 2                # max sandboxes kept warm at once (bounds the
#                             #   most-recently-used keeps; active/busy/pane-held
#                             #   worktrees are always kept regardless)
# idle_ttl_secs = 300         # idle seconds before a non-essential warm sandbox
#                             #   may suspend
# eager = "active"            # provision AHEAD of focus so the one-time nix/devShell
#                             #   minutes happen in the background. off | active
#                             #   (active worktree + newly-created) | workspace
#                             #   (whole active workspace) | all (every worktree)
# keep_active_warm = true     # the focused worktree's sandbox is always warm
# keep_busy_warm = true       # a worktree with a live in-sandbox process stays
#                             #   warm past the TTL (dev server / agent)
# serve_cached_glyphs = true  # show cached git status/activity for non-warm
#                             #   provider worktrees instead of waking them to poll
# cost_per_warm_hour = 0.0    # est. $/warm-sandbox-hour, for the ceiling below
# cost_ceiling_per_hour = 0.0 # trim the warm set to stay under this $/hr; 0 ⇒ off
#
# HIBERNATION (ephemeral compute, durable state): a commodity VPS (hetzner/
# digitalocean) bills while the instance EXISTS, even stopped — so an eligible
# CLAIMED sandbox idle past this TTL hibernates: the host captures the
# worktree's git/file state (unpushed commits as a git bundle + uncommitted
# tracked changes as a binary patch + untracked files as a tar), verifies it
# into the [lifecycle.snapshot] store, DESTROYS the instance, and the next
# open of that worktree transparently recreates + restores it.
# ⚠ Only that triple survives. Anything else on the VM — build caches, docker
# volumes, databases, the warm nix store — is EPHEMERAL and rebuilt on the
# next open (expect the usual provision time). Never hibernates while a pane
# is attached, a process is busy, or the capture failed (a failed capture
# always keeps the VM). Per-env control: `[env.<name>.provider] hibernate`.
# hibernate_after_secs = 3600 # idle seconds before an eligible sandbox
#                             #   hibernates; 0 ⇒ off globally
# [lifecycle.pool]            # WARM SPARE POOL: keep N pre-provisioned, unclaimed
# size = 0                    #   sandboxes ready per (repo, env) so the NEXT worktree
#                             #   CLAIMS one instantly (bind + branch checkout) instead
#                             #   of provisioning from scratch. 0 (the default) ⇒ OFF: the
#                             #   pool is strictly opt-in — idle spares consume provider
#                             #   quota (fatal on a low-limit account), so nothing is minted
#                             #   unless you set a non-zero size (clamped to a ceiling of 8).
#                             #   Refills in the background right after a claim. Adjust live
#                             #   with the warm-pool-increment / -decrement hotkeys
#                             #   (Ctrl+Alt+= / Ctrl+Alt+-), which persist a per-repo+env
#                             #   override (incl. 0 to force off); the sidebar header shows
#                             #   `warm ready/target`.
# max_idle_secs = 600         # AgeOut providers (VPS) only: reap an unclaimed member idle
#                             #   longer than this. Scale-to-zero spares are PARKED, not
#                             #   aged out (they still rotate when flake.lock changes).
# # Recycle checkpointed spares by restoring them IN PLACE (seconds) instead of
# # destroy+rebuild (minutes) when they go stale or their worktree is deleted;
# # lockfile-freshness guarded, destroy on any failure. false = always destroy.
# recycle = true
# [lifecycle.snapshot]        # WHERE hibernation snapshots live
# backend = "local"           # local (this host's disk; zero config) | s3
# dir = ""                    # local: root override; empty ⇒
#                             #   $XDG_STATE_HOME/thegn/snapshots
# keep = 3                    # snapshots retained per (repo, worktree, env)
# max_artifact_mb = 512       # abort the hibernate (keep the VM, warn) if any
#                             #   single artifact exceeds this; 0 ⇒ no ceiling
# bucket = ""                 # s3: bucket name (required for backend = "s3")
# endpoint = ""               # s3: endpoint URL for S3-compatibles (R2/B2/
#                             #   MinIO…); empty ⇒ AWS S3
# region = "us-east-1"        # s3: region
# prefix = "thegn"         # s3: key prefix inside the bucket
# access_key = "env:AWS_ACCESS_KEY_ID"      # secret ref: env:VAR | keyring:<n>
# secret_key = "env:AWS_SECRET_ACCESS_KEY"  #   | file:/path | bare env-var name

# ── Placement engine ─────────────────────────────────────────────────────────
# WHERE each worktree sandbox runs: Dedicated (one sandbox, exclusive host),
# Packed (bin-packed with others onto a shared Ready [host.*] via thegn's own
# container engine), or a freshly autoscaled Managed VPS. OFF by default — with
# `enabled = false` every existing spawn path is byte-identical. Explicit
# `[env.<n>] host = "..."` pins always bypass the broker (but are still
# accounted in the capacity ledger). Decisions are pure + deterministic; ask
# `thegn placement plan --json` why a spawn would land where.
#
# RESOURCE VIEW: every host — managed and independent — carries three layers:
# the DECLARED spec (authoritative for managed hosts), the RESERVED totals
# (Σ of live tenants' declared floors), and the latest MEASURED sample
# (observational; display + ranking hints, never a capacity source where a
# spec exists). `thegn placement list` renders all three.
[placement]
enabled = false
# preset = "none"             # preference bundle: cost_optimized (pack hard,
#                             #   queue on exhaustion) | latency_optimized
#                             #   (spread, reject) | isolated (dedicated only,
#                             #   halt) | balanced. Fills only keys still at
#                             #   their built-in defaults — anything you set
#                             #   explicitly wins; never touches constraints.
# mode = "auto"               # auto (broker chooses; packed when trust+capacity
#                             #   allow, else an empty host) | packed | dedicated.
#                             #   Per-env override: `[env.<n>] placement_mode`.
# strictest_allowed_mode = "auto"  # CONSTRAINT floor (trusted layers only):
#                             #   requests may be stricter, never looser
#                             #   (auto < packed < dedicated).
# pack_strategy = "bin-pack"  # bin-pack (consolidate: most-utilized first, idle
#                             #   hosts drain + scale down) | spread (least-
#                             #   utilized first: latency headroom, blast radius)
# on_exhaustion = "queue"     # queue (fall through this once; thegn nudges
#                             #   when capacity frees — re-open to place) |
#                             #   reject (silently use the env's non-engine
#                             #   path) | error (halt loudly)
# overcommit = 2.0            # cpu packing ceiling = spec × this (floors are
#                             #   declared asks, not live usage)
# mem_overcommit = 1.0        # memory is not compressible: default no overcommit
# independent_safety_pct = 85 # haircut on user-owned hosts' packing ceilings
#                             #   (their size is a claim, not a spec — see
#                             #   [host.<n>] capacity)
# headroom_ttl_secs = 60      # measured-sample max age before a placement
#                             #   decision re-probes (lazy; never idle polling)
# spillover_envs = []         # ordered SPILLOVER lane: [env.<name>] provider
#                             #   envs (e.g. a sprites env) tried when the
#                             #   owned pool + autoscale are exhausted. Health-
#                             #   tracked (429 cools down honoring the vendor,
#                             #   402 parks until the ledger clears, create
#                             #   failures escalate) with implicit fail-back;
#                             #   budget-gated; sticky per worktree. Global/
#                             #   profile config only — a repo overlay cannot
#                             #   name spillover targets.
# max_monthly_spend = 0.0     # USD/month cap for the COMPUTE ledger's global
#                             #   scope (0 = uncapped). Breach pauses PAID
#                             #   lanes (autoscale + spillover) per
#                             #   on_exhaustion; packing onto already-paid
#                             #   hosts keeps serving.
# [placement.price]           # hourly USD rates for the compute ledger
# "hetzner:cx33" = 0.0154     #   autoscaled hosts ("provider:size", fallback
# "hetzner" = 0.008           #   "provider"); unpriced resources meter at $0
#                             #   with a one-time warning
# [placement.default_resources] # fallback ask when an env declares none
# cpu = "1"                   #   cpu floor ("2", "0.5", "500m")
# memory = "2g"               #   memory floor ("4g", "512m", bare = MiB)
# cpu_max = ""                #   optional container --cpus limit (see
# memory_max = ""             #   [env.<n>.resources] cpu_max/memory_max)
# [placement.autoscale]       # create Managed VPS hosts on pool exhaustion.
# enabled = false             #   Enabling this IS the create+install consent for
#                             #   engine-created hosts (thegn owns those boxes).
# max_hosts = 3               #   ceiling on engine-created hosts (0 ⇒ default 3)
# min_hosts = 0               #   floor kept alive by scale-down (warm capacity)
# scale_down_idle_secs = 900  #   a Managed host with zero tenants this long is
#                             #   destroyed (a parked pool spare counts as a
#                             #   tenant, so it keeps its host warm on purpose)
# cooldown_secs = 60          #   base cooldown after a lane's create failure
#                             #   (escalates per consecutive failure)
# [[placement.autoscale.managed]] # ORDERED failover lanes (first viable wins;
# provider = "hetzner"        #   a failed lane cools down and the next spawn
# region = "fsn1"             #   tries the next lane; fail-back on expiry)
# size = "cx33"               #   vendor plan — the lane's identity (cx33 =
# cpu = "4"                   #   4 vCPU / 8 GB; declared spec, authoritative for
# memory = "8g"               #   the capacity index from create time)
# max = 2                     #   per-lane ceiling (0 ⇒ 1)
# [[placement.autoscale.managed]] # a second lane: spill to DigitalOcean when the
# provider = "digitalocean"   #   Hetzner lane is capped or failing
# region = "nyc3"
# size = "s-4vcpu-8gb"
# cpu = "4"
# memory = "8g"
# max = 2
# ── Control plane (pane daemon + serve) ────────────────────────────────────
# The pane daemon: a `thegn daemon` process that owns the portable-pty panes
# so they survive the UI exiting — quit the compositor, relaunch, and
# warm-reattach to a still-running agent (tmux semantics). ON by default:
# quitting detaches your worktree panes (they keep running; the exit message
# says how many were kept), while explicitly CLOSING a pane/tab kills its
# process. Pins, the tool drawer, and the corner overlay stay in-process and
# die with the UI. Set `enabled = false` for plain in-process PTYs that die
# with the compositor.
[daemon]
# Disabling the route (here, or per-run with THEGN_NO_DAEMON=1) while
# daemon-backed panes are persisted STOPS those daemon sessions on the next
# launch: each pane respawns without the daemon and its now-orphaned daemon
# copy is killed (best-effort) rather than left running invisibly forever.
enabled = true
# Control-socket override. Empty (default) resolves to
# $XDG_RUNTIME_DIR/thegn/daemon.sock, falling back to
# $XDG_STATE_HOME/thegn/run/daemon.sock (so isolated state dirs — `just
# start`, smoke tests — get isolated daemons).
socket = ""
# The daemon exits after this long with no live sessions. 0 = never exit on
# idle. Ignored by `thegn serve`: a serving daemon keeps its TCP listener up for
# thin clients that haven't attached yet, so it never idle-exits.
idle_exit_secs = 1800
# When the last client detaches from a session, keep its PTY warm this long
# (the relay lease). Reconnect within the grace resumes the same live screen;
# expiry reaps the process. 0 (the default) = never reap: a detached session
# lives until you close its pane, kill it (`thegn session list`), or the
# machine restarts — that's what makes "come back tomorrow" work.
# (Env kill-switch: THEGN_NO_DAEMON=1 force-disables daemon routing for one
# run — test/bench harnesses that kill the compositor without a quit use it.)
lease_grace_secs = 0

# `thegn serve`: pair remote thin clients (desktop/web/mobile) over a pairing
# URL and let them attach through the scoped control API. v1 serves PLAINTEXT —
# bind to a trusted network interface (tailscale/wireguard) or reach it over
# `ssh -L`; every request is still token-gated.
[serve]
# Default TCP bind (override per-run with `thegn serve --bind`). Loopback by
# default — the control plane carries full PTY I/O over plaintext, so exposing
# it beyond localhost is opt-in. For remote clients, front it with a
# tailnet/VPN address or an explicit `bind = "0.0.0.0:5380"` behind a firewall.
bind = "127.0.0.1:5380"
# Require in-app / `thegn pair approve` approval before a redeemed pairing
# token becomes usable. Default off: possession of the single-use pairing URL
# is the credential.
require_approval = false
# Local unix-socket peers (same uid) get implicit admin, so local CLI verbs
# (`thegn session …`) need no token. Tokens are always required on TCP.
local_admin = true

# ── Local merge queue: the "fold-actor" (optional) ─────────────────────────
# Stop hand-sequencing parallel branches into main. The fold-actor folds every
# queued worktree branch onto `target_branch` entirely in the git object
# database (no checkout, milliseconds): branches that merge clean land
# automatically as sequential merge commits, and only genuine conflicts are
# deferred for you (or an agent) to resolve. Fire it once with `thegn
# integrate` / the palette action.
#
# Manage the queue from the TUI via the palette's "Merge queue" (the
# `open-merge-queue` action has no default chord — bind it in [keybinds])
# opens Work ▸ Merge queue, where `a`/`A` enqueue, `x` removes, `r` retries,
# `l` lands a ready branch, `c` clears landed rows, and `D` drains the queue
# with the agent autopilot — transitions stream into the panel live, and the
# settled ones (queue_landed / queue_ready / queue_needs_human) toast and land
# in the notifications inbox. CLI equivalent: `thegn merge …`.
#
# Because ten clean *textual* merges say nothing about whether their *union*
# builds, the fold is test-gated: the folded tip is checked out into a throwaway
# worktree, `gate_command` runs, and main only advances (atomic compare-and-swap)
# if it's green — bisecting the offending branch on red. This is the real
# correctness wall, automated rather than babysat.
#
# On by default; the core (fold + integrate) is AI-free — the agent handoff is
# the only AI touch and only fires on a conflict. Set enabled = false to remove
# the command, panel section, and badge entirely.
# PER-REPO: every interesting key below describes a *repository* — its build
# tool, its integration branch, its lockfiles — so a repo that differs from your
# defaults belongs in a `[workspace.<slug>.merge_queue]` block rather than in
# `--set` flags on every invocation. The slug is the repo directory name,
# slugified. It overrides the global table for that repo only:
#
#   [workspace.datahub.merge_queue]
#   target_branch      = "ba/rearch"          # this repo integrates elsewhere
#   gate_setup_command = "pnpm install --frozen-lockfile"
#   gate_command       = "pnpm test"          # not the global "just test"
#
# `thegn config explain merge_queue.gate_command`, run inside the repo, shows
# which layer won.
[merge_queue]
enabled = true
remote_mode = "route_to_host" # how a REMOTE-host (sprite) worktree lands onto the target;
                              # inert for an on-host worktree. "route_to_host": send the
                              # enqueue to the target host's daemon over the control plane so
                              # the host's queue owns the row (needs a control endpoint +
                              # merge-scoped token injected into the sprite). "push": the sprite
                              # drains its OWN clone (fold+gate+advance), then `git push`es the
                              # target to origin — no host reach; origin is the convergence point.
target_branch = "auto"        # branch to advance; "auto" = repo HEAD/default
gate_command = ""             # e.g. "just test" / "cargo nextest run --workspace"; "" disables the gate.
                              # Prefer a LEAN gate: the pre-push hook already ran clippy + full
                              # test + smoke before enqueue, so "just lint && just test" mostly
                              # repeats that compile work. "just test" alone is ~3x cheaper.
                              # NOTE: this runs in a BARE checkout of the folded tip — no
                              # node_modules, no virtualenv, no .direnv. A command whose entry
                              # point is a project-local binary (turbo, pytest in a venv, a Go
                              # tool dir) will NOT resolve; provision it with gate_setup_command
                              # below. Rust works out of the box only because cargo is global.
gate_setup_command = ""       # run in the gate worktree BEFORE gate_command, to install what the
                              # gate needs: "pnpm install --frozen-lockfile", "uv sync",
                              # "bundle install", … "" skips it. NOT part of the pass/fail
                              # verdict — a non-zero exit is reported as a gate ENVIRONMENT
                              # failure ("gate_error"), never as "this branch breaks the build",
                              # so a broken setup can neither blame a branch nor wake the agent.
                              # Runs on every gate invocation (including an in-place refresh of a
                              # reused worktree), so keep it idempotent and cheap when warm.
gate_on = true                # run gate_command before advancing main
gate_reuse_worktree = true    # reuse a stable per-repo gate worktree + target dir between folds
                              # (warm incremental rebuild instead of a cold from-scratch compile).
                              # false = throwaway /tmp worktree each fold (cold; use for concurrent gates)
gate_target_dir = ""          # CARGO_TARGET_DIR for the gate; "" = $XDG_STATE_HOME/thegn/gate/<repo>/target
bisect_on_red = true          # on a red gate, defer just the offending branch
snapshot_dirty = false        # auto-commit uncommitted worktree work before folding
regenerate_paths = ["Cargo.lock", "pnpm-lock.yaml", "package-lock.json", "yarn.lock",
                    "bun.lockb", "poetry.lock", "uv.lock", "Pipfile.lock", "go.sum",
                    "Gemfile.lock", "composer.lock"]
                              # conflicts confined to these are "regenerable", not handed off.
                              # Matched by exact path OR basename. A name costs nothing in a repo
                              # that doesn't have that file, so the default spans ecosystems.
regenerate_command = ""        # e.g. "cargo update --workspace"; rebuilds regenerate_paths to auto-land them ("" defers instead)
conflict_handoff = "agent"    # agent | notify | manual — fate of a deferred branch
#
# Agent autopilot: with conflict_handoff = "agent" and agent_command set, the
# queue driver (`thegn merge queue drain`) grinds queued branches one by one —
# dispatching a headless CLI agent INSIDE the branch's own worktree to rebase onto
# the target, resolve conflicts, and fix a red gate, then re-attempting the fold
# and auto-landing on green. The agent never touches main; thegn does the
# object-DB fold + CAS itself. {prompt}/{branch}/{target} are substituted.
#
# WRITE PLACEHOLDERS BARE. Every substituted value is shell-quoted for you, so
# `-p {prompt}` is correct and `-p "{prompt}"` is not — quoting it yourself hands
# the agent a prompt with literal quote characters wrapped around it.
# `thegn config validate` reports the mistake.
agent_command = ""            # e.g. 'claude -p {prompt} --permission-mode acceptEdits'; "" ⇒ agent handoff degrades to notify
#
# ...or just name one of your [[agents]]/[[tools]] entries and let thegn supply
# the headless flags for its provider (claude ⇒ `-p … --permission-mode
# acceptEdits`, codex ⇒ `exec`, aider ⇒ `--yes --message`). An agent thegn
# doesn't recognize still runs, with the prompt appended as an argument.
# agent_command wins when both are set; with neither, the handoff notifies.
agent = ""                    # e.g. "claude" — an [[agents]] name
auto_land = true              # queue driver: CAS-advance on green; false ⇒ stop at "ready" for a manual land
agent_max_attempts = 2        # agent-dispatch → re-fold cycles before marking a branch "needs_human".
                              # The budget belongs to the BRANCH and is persisted, so a later drain
                              # doesn't spend it again; `thegn merge retry` re-arms a row.
agent_timeout_secs = 900      # watchdog per agent invocation; 0 disables
#
# Sidebar organization (ON by default). As a branch moves through the queue,
# file its worktree into sidebar folders so in-flight / merged / blocked work is
# grouped at a glance, and — once a branch lands cleanly — remove its now-dead
# worktree so the workspace stays "live work only". By default: enqueued work is
# filed into queued_folder, a clean land removes the worktree AND deletes the
# merged branch (on_landed = "remove"), and failures move to failed_folder. Set
# organize_folders = false to disable the whole lifecycle, or on_landed = "detach"
# to keep merged branches ("move"/"off" keep the worktree). Only landings through
# thegn's own merge queue trigger this (not GitHub / manual git merges). A worktree
# open as a live tab is torn down cleanly (like closing it) when on_landed removes
# it; the home worktree is never filed or removed. Out-of-process `merge add`
# changes may take up to ~2 s to appear in a running instance (git-watch / ticker).
organize_folders = true       # master switch for the folder automation below
queued_folder = "Merging"     # file a worktree here when its branch is enqueued ("" ⇒ don't)
on_landed = "remove"          # off | move | detach | remove — what to do when a branch lands
                              #   move   = file the worktree into merged_folder
                              #   detach = remove the worktree, keep the branch
                              #   remove = remove the worktree AND delete the merged branch
merged_folder = "Merged"      # destination folder when on_landed = "move" ("" ⇒ don't file)
failed_folder = "Needs attention"  # folder for a branch that fails to land ("" ⇒ leave it be)

# What the fixing agent is TOLD, per blocker kind. Leave a key empty (the
# default) to use thegn's built-in instructions for that kind — the ones that
# explain the blocker, then require the agent to commit on the branch, never
# push, and never touch the target (thegn lands it, which is what preserves the
# object-DB coherence guarantee). Override a key to add your repo's conventions.
#
# These are PROSE templates, not shell — they are not quoted, and the rendered
# text also reaches the agent as $THEGN_TASK_PROMPT. Placeholders are per kind
# and an unknown one is a `config validate` error, not a silent blank:
#   conflict     — {branch} {target} {worktree} {paths}   (one "  - path" line each)
#   gate_failure — {branch} {target} {worktree} {log}     (the gate output tail)
[merge_queue.prompts]
conflict = ""                 # "" ⇒ thegn's built-in conflict instructions
gate_failure = ""             # "" ⇒ thegn's built-in red-gate instructions
# A repo can carry its own, alongside its own gate:
#   [workspace.datahub.merge_queue.prompts]
#   gate_failure = """
#   The gate is red on `{branch}`. Tail:
#
#   {log}
#
#   Fix it, then run `pnpm lint --fix` before committing. Do NOT push.
#   """

# ── PR queue (team mode) ────────────────────────────────────────────────────
# The merge queue's counterpart for a SHARED repo. Where the merge queue folds
# local branches onto a local target, the PR queue watches **pull requests** on
# the forge: it polls each queued PR, works out what is blocking it (red checks,
# a conflict with the base, requested changes), optionally hands that blocker to
# an agent in the PR's own worktree, and lets the PR merge once it is green.
#
# The guarantee is the mirror of the merge queue's. There the agent never pushes
# and thegn does the fold. Here the agent DOES push (that is the only way a pull
# request advances) but never merges — by default thegn just switches on the
# forge's own auto-merge, so branch protection, required reviews, and any
# server-side merge queue stay in charge.
#
# OFF by default: this is the one part of the shell that makes network *writes*.
# CLI: `thegn pr queue add|list|rm|clear|status|drain`.
#
# PER-REPO: like [merge_queue], these describe a *repository* — its review rules,
# its merge style — so a repo that differs belongs in a
# `[workspace.<slug>.pr_queue]` block (same all-Option overlay shape).
[pr_queue]
enabled = false               # master switch; false ⇒ no polling, no command, no panel section
poll_interval_secs = 60       # how often a queued PR's remote state is refreshed (floored at 15s
                              #   so a typo can't hammer the forge's rate limit)
auto_enqueue = "off"          # off | worktree — whether opening a PR from a worktree queues it.
                              #   Off by default: a queued PR is one thegn may write to.
watch = ["ci", "conflict", "review"]   # which blocker classes may wake the agent. A class left out
                              #   is still tracked and displayed — it just never gets an agent.
#
# The agent, exactly as in [merge_queue]: name an [[agents]] entry, or spell out
# a command. Placeholders are shell-quoted, so write them BARE. With neither set,
# blockers are reported but never fixed.
agent = ""                    # e.g. "claude" — an [[agents]] name
agent_command = ""            # e.g. 'claude -p {prompt}'; overrides `agent`
agent_max_attempts = 2        # agent-dispatch cycles per PR before it is marked "needs_human"
agent_timeout_secs = 900      # watchdog per agent invocation; 0 disables
#
# Team safety. These are the rules that make an agent safe to point at a shared
# repo, and the defaults assume you have colleagues:
reset_attempts_on_push = true # a new head commit refills the attempt budget. A PR lives for days,
                              #   so a one-shot budget would exhaust once and stick forever. Only a
                              #   head thegn did NOT create refills it, so an agent can't top up its
                              #   own budget by pushing.
pause_on_foreign_push = true  # if the head moved and thegn didn't move it, someone else pushed —
                              #   stop and ask for a human rather than racing them
own_prs_only = true           # never let the agent write to a PR you didn't author (watching and
                              #   displaying someone else's PR is still fine)
#
# Merging. The default hands the decision to the forge on purpose.
merge_mode = "auto_merge"     # auto_merge | thegn | ready
                              #   auto_merge = switch on the forge's auto-merge; IT merges, under
                              #                its own branch protection (the safe default)
                              #   thegn      = thegn merges it directly when its own gates pass
                              #   ready      = never merge; just mark it ready and tell you
merge_method = "squash"       # squash | merge | rebase — strategy requested of the forge
delete_branch_on_merge = true # ask the forge to delete the head branch after merging
require_approval = true       # hold a PR until its review decision is approving. Merging unreviewed
                              #   work is exactly what a team does not want automated.
require_checks = true         # hold a PR until every check has passed
#
# Sidebar organization, same shape as [merge_queue]'s.
organize_folders = true       # master switch for the folder automation
queued_folder = "In review"   # file a worktree here when its PR is queued ("" ⇒ don't)
failed_folder = "Needs attention"  # folder for a PR that needs a human ("" ⇒ leave it be)

# What the agent is told, per blocker kind. Empty ⇒ thegn's built-in instructions
# (which require a `--force-with-lease` push and forbid merging, closing, or —
# for review feedback — resolving the reviewer's threads). Prose, not shell:
# these are never quoted. Placeholders are per kind, and an unknown one is a
# `config validate` error:
#   ci_failure — {branch} {base} {worktree} {pr_number} {pr_url} {pr_title} {checks} {log}
#   conflict   — as above, without {checks}/{log}
#   review     — as above, with {threads} instead
[pr_queue.prompts]
ci_failure = ""               # "" ⇒ thegn's built-in red-checks instructions
conflict = ""                 # "" ⇒ thegn's built-in behind/conflicting instructions
review = ""                   # "" ⇒ thegn's built-in review-feedback instructions

# ── Time-travel replay (optional) ───────────────────────────────────────────
# Record each pane's full byte stream into a bounded in-memory ring so you can
# scrub a pane's history like a video (Alt+r): play/pause, step, seek, skip idle
# gaps — and search for any string that EVER appeared on screen, including inside
# full-screen apps (vim/htop) whose output never reaches scrollback. Distinct from
# the whole-session asciinema recorder (Ctrl+Alt+r), which writes a .cast file.
#
# On by default and bounded by BOTH a byte and a duration budget per pane; when
# enabled = false no ring is allocated and recording costs a single null check.
[replay]
enabled = true                 # master switch; false ⇒ zero cost, no recording
max_bytes_per_pane = 8388608    # per-pane ring byte budget (8 MiB); oldest events evicted past this
max_duration_secs = 1800        # per-pane time budget (30 m); older events evicted
keyframe_interval_ms = 4000     # capture a scrub-timeline marker after this much activity …
keyframe_interval_bytes = 262144 # … or after this many bytes, whichever first (256 KiB)
idle_threshold_ms = 1000        # during playback, gaps longer than this are collapsed (skip-inactivity)
persist = false                 # mirror rings to $XDG_STATE_HOME/thegn/replay/<session>/<pane>.szr for cross-restart scrubbing

# ── Media player control (optional) ────────────────────────────────────────
# Drive your music/media player from thegn: play/pause, next/previous,
# shuffle, loop, volume, and a playlist/player picker — plus a now-playing
# statusbar badge and panel section. The shell never depends on this; it is
# strictly additive.
#
# `backend = "auto"` (the default) picks the right backend for your OS:
#   • Linux   → MPRIS (org.mpris.MediaPlayer2) — native zbus, falling back to the
#               `playerctl` CLI. Controls Spotify, mpv (mpris plugin), ncspot,
#               spotify-player, musikcube, moc, VLC, cmus, … (install `playerctl`
#               if zbus can't reach your session bus).
#   • Windows → SMTC (System Media Transport Controls) — whatever app owns the
#               system media session (Spotify, browsers, Groove, …).
#   • macOS   → AppleScript via `osascript` — Music.app + Spotify.
# Force a specific backend with `mpris` / `smtc` / `applescript`, or `mpv` to
# drive a single mpv instance over its JSON IPC socket (see [media.mpv]).
# `jellyfin` is reserved. A backend selected on the wrong OS is simply inert.
#
# Only the selected backend's sub-table is consulted. On by default; it degrades
# to inert (no badge, no panel section, no watcher) wherever no supported player
# is reachable. Set enabled = false to remove the badge, the panel section, and
# make every media-* keybind inert — zero idle cost.
[media]
enabled = true
# auto | none | mpris | mpv | mpd | smtc | applescript | jellyfin
# "auto" composes EVERY source reachable on this OS and shows whatever is actually
# playing — on Linux that's MPRIS (browsers/Spotify/VLC/mpv-with-mpv-mpris) + native
# MPD (mpd/mpc/rmpc/ncmpcpp, no mpd-mpris bridge needed) + a live mpv IPC socket, all
# at once. Windows uses SMTC (every app), macOS the MediaRemote adapter → AppleScript.
backend = "auto"
# Preferred players (name tails) when several are playing at once; the first match
# wins across all sources. Empty = pick whatever is actively playing, else the first.
players_priority = []        # e.g. ["mpd", "spotify", "mpv"]
# Reserved single "media key" action (each transport op already has its own
# bindable action id: media-play-pause, media-next, …).
default_action = "play_pause"  # play_pause | next | previous | volume_up | volume_down
# Volume step (0.0–1.0) for media-volume-up / media-volume-down.
volume_step = 0.05
# Seek step (seconds) for media-seek-forward / media-seek-back. Video uses the
# larger step, matching the coarser skipping people expect from a video player.
seek_step_secs = 10
seek_step_video_secs = 30
# Render cover art in the Now-Playing overlay (Alt-m) when the backend exposes it
# and the terminal supports kitty/sixel graphics; otherwise a block-glyph mosaic.
show_art = true
# Open the Now-Playing overlay when the statusbar media badge is clicked.
overlay_on_badge_click = true
# Fallback poll cadence (seconds) for backends WITHOUT a push stream (a live mpv
# IPC socket / playerctl). Native MPRIS (D-Bus signals), native MPD (`idle`),
# SMTC session events, and the MediaRemote `stream` are all push, so this never
# fires for them (the ~0%-idle contract holds).
poll_interval_secs = 3

# [media.mpv]   # backend = "mpv" (or auto, when the socket exists): launch mpv
# socket = "/tmp/mpvsocket"    # with --input-ipc-server=<socket>

# [media.mpd]   # native MPD — picks up mpd/mpc/rmpc/ncmpcpp with no mpd-mpris bridge.
# socket = "127.0.0.1:6600"    # host:port, or an absolute path to MPD's unix socket.
                               # $MPD_HOST / $MPD_PORT override when left at default.
# password = "hunter2"         # only if your MPD requires one

[usage]
# AI-account usage tracker (open-usage / command palette "AI account usage"): a
# detail overlay of per-account rate-limit windows (session / weekly / …) as usage
# bars with a "resets in …" countdown, modeled on orca. Strictly additive — the
# AI-free shell never depends on it. It only READS credentials the harnesses
# already wrote locally; thegn never asks for or stores an API key.
enabled = true
# Which harnesses to track, in display order. Unknown ids are ignored.
providers = ["codex", "claude", "antigravity"]
# Allow the outward-facing live fetches. Only Codex persists its rate-limit
# snapshot to disk (read offline from ~/.codex/sessions/); Claude and Antigravity
# don't, so their windows require a lightweight authenticated request using the
# on-disk OAuth token (Anthropic /api/oauth/usage; Antigravity quota summary),
# run off the event loop. Left false, those two show "unavailable" and no network
# call is ever made. Opt in to see Claude/Antigravity usage.
allow_network = false
# Reserved: re-poll cadence (seconds) for a live refresh while the overlay is open.
# v1 gathers once when the overlay is opened, so this is currently advisory.
poll_interval_secs = 60
