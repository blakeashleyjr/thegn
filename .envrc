# shellcheck shell=bash
# direnv integration: auto-enter the project dev environment on `cd` so the
# toolchain (rust, just, shellcheck, yamllint, taplo, treefmt, …) is on PATH
# without a manual `nix develop`. Run `direnv allow` once; requires direnv
# + nix-direnv.
#
# This is a CONVENIENCE for working directly on thegn. thegn itself does
# NOT depend on it — sandboxed worktree panes get the devShell toolchain
# automatically via `[sandbox] inject_devshell` (see crates/thegn-core/src/devenv.rs).
#
# Two backends, split on THEGN_DEVSHELL:
#  - Sandboxes/sprites SET THEGN_DEVSHELL (via `[sandbox] devshell`, e.g.
#    `sandbox`/`sprite-full`) and MUST use the flake devShell — a smaller closure
#    that `inject_devshell`/`warm_direnv` already build + cache, and the only
#    shell reachable from inside the read-only /nix sandbox. Never devenv there.
#  - On the host THEGN_DEVSHELL is unset → the full devenv shell (devenv.nix) is
#    the default, so `direnv allow` yields ONE integrated dev env (no separate
#    `devenv shell` step). The flake devShell (devShells.default) still exists and
#    stays load-bearing for sandbox injection, which reads flake.nix directly.
if [ -n "${THEGN_DEVSHELL:-}" ]; then
  use flake ".#${THEGN_DEVSHELL}"
elif has devenv; then
  # Host default: the full devenv shell (devenv.nix). Source devenv's own direnv
  # helper straight from the installed binary — hermetic (no network fetch, no
  # pinned source_url hash to maintain), and always matches the devenv on PATH.
  # shellcheck disable=SC1090  # dynamic source: devenv prints its own direnvrc
  source <(devenv direnvrc)
  use devenv
else
  # devenv missing on the host: fall back to the flake devShell so the toolchain
  # still loads. (Install devenv — https://devenv.sh — for the full dev env.)
  log_status "devenv not found; falling back to the flake devShell"
  use flake ".#default"
fi

# Machine-local secrets (gitignored), e.g. SPRITES_TOKEN for the [env.sprites]
# managed-sandbox provider. Put `SPRITES_TOKEN=...` in `.envrc.local`; direnv
# loads it so `just start-term-release` forwards it into the host. Run
# `direnv allow` after creating/editing the file.
dotenv_if_exists .envrc.local
