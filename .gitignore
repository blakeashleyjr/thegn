/target
result
result-*
.direnv/
# Leftover state from the removed devenv setup. Nothing creates these any more
# (see flake.nix's `preCommit`); kept ignored so a stale local dir doesn't show
# up as untracked. Safe to `rm -rf .devenv/` and drop these lines.
.devenv/
.devenv.flake.nix
devenv.local.nix
# Generated by the flake devShell's git-hooks block (a /nix/store symlink).
.pre-commit-config.yaml
__pycache__/
.opencode/
# `.claude/` is generated (openspec seeds commands/ and skills/ per checkout —
# `just openspec-setup`), EXCEPT settings.json: the heavy-command guard is a
# committed repo policy, not per-checkout scaffolding. See test/heavy-guard.sh.
# `.claude/*` not `.claude/`: git cannot re-include a file whose PARENT
# DIRECTORY is excluded, so excluding the contents is what makes the negation
# below work at all.
.claude/*
!.claude/settings.json

# Machine-local per-repo backend overlay written by `just start-term[-release]
# backend=<x>` (dogfood switch); not committed — see `_apply-backend` in justfile.
.thegn.toml

# Machine-local secrets sourced by .envrc (e.g. SPRITES_TOKEN); never committed.
.envrc.local
# Local-CI (act) secrets — NIX_GITHUB_TOKEN etc.; see .secrets.example.
.secrets
.thegn.yaml
.thegn.yml
.thegn.json

# muse e2e failure artifacts (`just e2e`); baselines live in test/muse/snapshots/
e2e-results/
# a stray `muse run` without --snapshots-dir would create baselines here
/snapshots/
/test-results/

# Knowledge-graph tool scratch (present in every worktree; never committed).
# Left untracked it makes `thegn integrate` classify clean branches as dirty.
.understand-anything/
